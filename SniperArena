    f.ZIndex = z or 20
    f.Parent = parent
    return f
end

-- RenderStepped can call this 60-240+ times/sec. Cache the last values so
-- Roblox only receives UI property writes when something actually changed.
local GuiLineState = setmetatable({}, {__mode = "k"})
local function setGuiLine(frame, a, b, color, thickness, opacity)
    if not (frame and a and b) then return end
    local d = b-a
    local len = d.Magnitude
    local st = GuiLineState[frame]
    if not st then st = {}; GuiLineState[frame] = st end
    if len < .5 then
        if st.visible ~= false then frame.Visible=false; st.visible=false end
        return
    end

    local px, py = (a.X+b.X)*.5, (a.Y+b.Y)*.5
    local h = math.max(1, thickness or 1)
    local rot = math.deg(math.atan2(d.Y,d.X))
    local trans = 1-math.clamp(opacity or 1,0,1)

    -- Small sub-pixel tolerances avoid pointless writes caused by floating noise.
    if not st.px or math.abs(st.px-px) > .05 or math.abs(st.py-py) > .05 then
        frame.Position = UDim2.fromOffset(px,py); st.px,st.py=px,py
    end
    if not st.len or math.abs(st.len-len) > .05 or st.h ~= h then
        frame.Size = UDim2.fromOffset(len,h); st.len,st.h=len,h
    end
    if not st.rot or math.abs(st.rot-rot) > .05 then frame.Rotation=rot; st.rot=rot end
    if st.color ~= color then frame.BackgroundColor3=color; st.color=color end
    if st.trans ~= trans then frame.BackgroundTransparency=trans; st.trans=trans end
    if st.visible ~= true then frame.Visible=true; st.visible=true end
end

