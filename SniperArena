-- Keeps the window on screen whatever the GUI Scale slider / screen size says.
function UI:ApplyScale()
    if not (self.Scale and self.Main and self.Main.Parent) then return end
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local want = (self.MobileScale or 1) * (Util.Number(xDTaraZ.Options.GuiScale, 90, 60, 110) / 100)
    local w, h = math.max(self.Main.Size.X.Offset, 1), math.max(self.Main.Size.Y.Offset, 1)
    local fit = math.min((vp.X - 12) / w, (vp.Y - 50) / h)
    self.Scale.Scale = math.max(.4, math.min(want, fit))
end

function UI:SetOption(key, value)
    xDTaraZ.Options[key] = value
    if key == 'GuiScale' then self:ApplyScale() end
    if key == 'AntiAfk' then if value then xDTaraZ.Player.AntiAfk.Start() else xDTaraZ.Player.AntiAfk.Stop() end end
    if not self.Building and xDTaraZ.ConfigStore and (key == 'AutoLoadConfig' or key == 'RememberLastProfile' or key == 'AutoSaveOnJoin' or key == 'AutoSaveOnUnload') then
        xDTaraZ.ConfigStore.SaveMeta()
    end
    if not self.Building and key ~= 'ConfigProfile' and xDTaraZ.AutoSave then
        -- AutoSave cannot queue itself after being switched OFF because Queue()
        -- intentionally ignores requests while AutoSave is false. Persist that
        -- one transition immediately; normal settings still use the debounce.
        if key == 'AutoSave' and value == false and xDTaraZ.ConfigStore and xDTaraZ.ConfigStore.Save then
            pcall(xDTaraZ.ConfigStore.Save)
        else
            xDTaraZ.AutoSave.Queue()
        end
    end
end

function UI:Tween(object,props,duration,style)
    local ok,tween=pcall(function()
        return TweenService:Create(object,TweenInfo.new(duration or .18,style or Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props)
    end)
    if ok and tween then tween:Play() else for key,value in pairs(props) do pcall(function() object[key]=value end) end end
end

function UI:Toast(title, message)
    if not self.ToastHolder then return end
    -- keep the stack short on small screens
    local live={}
    for _,child in ipairs(self.ToastHolder:GetChildren()) do if child:IsA('Frame') then live[#live+1]=child end end
    while #live>=4 do table.remove(live,1):Destroy() end

    local box=New('Frame',{BackgroundColor3=C.Card,Size=UDim2.new(1,0,0,54),BackgroundTransparency=1},self.ToastHolder); Corner(box,10); Stroke(box)
    local head=Label(box,{Position=UDim2.fromOffset(12,5),Size=UDim2.new(1,-22,0,18),Font=Enum.Font.GothamBold,Text=title,TextColor3=C.Text,TextTransparency=1,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})
    local body=Label(box,{Position=UDim2.fromOffset(12,23),Size=UDim2.new(1,-22,0,23),Font=Enum.Font.Gotham,Text=tostring(message),TextColor3=C.Muted,TextTransparency=1,TextSize=11,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top})
    local stripe=New('Frame',{BackgroundColor3=C.Accent,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(0,8),Size=UDim2.new(0,3,1,-16)},box); Corner(stripe,2)
    self:Tween(stripe,{BackgroundTransparency=0},.2)
    self:Tween(box,{BackgroundTransparency=.02},.2); self:Tween(head,{TextTransparency=0},.2); self:Tween(body,{TextTransparency=0},.2)
    task.delay(2.8,function()
        if not box.Parent then return end
        self:Tween(box,{BackgroundTransparency=1},.25); self:Tween(head,{TextTransparency=1},.25); self:Tween(body,{TextTransparency=1},.25); self:Tween(stripe,{BackgroundTransparency=1},.25)
        task.delay(.3,function() if box.Parent then box:Destroy() end end)
    end)
end

-- ------------------------------------------------------------------ layout: sidebar tabs + sub-tabs
function UI:SelectTab(tab)
    for _, other in ipairs(self.Tabs) do
        local on = other == tab
        other.Frame.Visible = on
        other.Bar.Visible = on
        self:Tween(other.Button, { BackgroundTransparency = on and 0 or 1 }, .15)
        self:Tween(other.Label, { TextColor3 = on and C.Text or C.Muted }, .15)
    end
    self.CurrentTab = tab
end

function UI:SelectSub(tab, sub)
    for _, other in ipairs(tab.Subs) do
        local on = other == sub
        other.Page.Visible = on
        self:Tween(other.Button, { BackgroundColor3 = on and C.SubActive or C.Card, TextColor3 = on and C.Text or C.Muted }, .15)
    end
    tab.CurrentSub = sub
end

function UI:LayoutSubs(tab)
    local n, gap = #tab.Subs, 6
    for i, sub in ipairs(tab.Subs) do
        sub.Button.Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0)
        sub.Button.Position = UDim2.new((i - 1) / n, gap * (i - 1) / n, 0, 0)
    end
end

function UI:AddTab(name)
    local btn = New('TextButton',{AutoButtonColor=false,Text='',BackgroundColor3=C.NavActive,BackgroundTransparency=1,Size=UDim2.new(1,0,0,34),LayoutOrder=#self.Tabs+1},self.NavList); Corner(btn,9)
    local bar = New('Frame',{BackgroundColor3=C.Accent,BorderSizePixel=0,Position=UDim2.new(0,0,.5,-10),Size=UDim2.fromOffset(3,20),Visible=false},btn); Corner(bar,2)
    local label = Label(btn,{Position=UDim2.fromOffset(15,0),Size=UDim2.new(1,-20,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=C.Muted,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd})

    local frame = New('Frame',{BackgroundTransparency=1,Visible=false,Size=UDim2.fromScale(1,1)},self.Content)
    local subBar = New('Frame',{BackgroundTransparency=1,Size=UDim2.new(1,0,0,34)},frame)
    local pages = New('Frame',{BackgroundTransparency=1,Position=UDim2.fromOffset(0,42),Size=UDim2.new(1,0,1,-42)},frame)

    local tab = { Name = name, Button = btn, Bar = bar, Label = label, Frame = frame, SubBar = subBar, Pages = pages, Subs = {} }
    table.insert(self.Tabs, tab)
    btn.Activated:Connect(function() self:SelectTab(tab) end)
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

-- Each Section is a sub-tab of its tab: a button in the row at the top plus its own scrolling page.
function UI:Section(tab, title, heading)
    local button = New('TextButton',{AutoButtonColor=false,BackgroundColor3=C.Card,Font=Enum.Font.GothamMedium,Text=title,TextColor3=C.Muted,TextSize=self.Compact and 10 or 12,TextTruncate=Enum.TextTruncate.AtEnd},tab.SubBar); Corner(button,9); Subtle(button)
    local page = New('ScrollingFrame',{BackgroundTransparency=1,BorderSizePixel=0,Visible=false,Size=UDim2.fromScale(1,1),AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=3,ScrollBarImageColor3=C.Accent},tab.Pages)
    Pad(page,0,0,6,10); New('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},page)

    local head=New('Frame',{BackgroundColor3=C.Card,Size=UDim2.new(1,0,0,38)},page); Corner(head,9); Subtle(head)
    Label(head,{Position=UDim2.fromOffset(14,0),Size=UDim2.new(1,-28,1,0),Font=Enum.Font.GothamBold,Text=string.upper(heading or title),TextColor3=C.Accent2,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left})

    local sub = { Name = title, Button = button, Page = page }
    table.insert(tab.Subs, sub)
    self:LayoutSubs(tab)
    button.Activated:Connect(function() self:SelectSub(tab, sub) end)
    if #tab.Subs == 1 then self:SelectSub(tab, sub) end
    return page
end

-- A tab with only one section does not need the sub-tab row.
function UI:FinishTabs()
    for _, tab in ipairs(self.Tabs) do
        if #tab.Subs <= 1 then
            tab.SubBar.Visible = false
            tab.Pages.Position = UDim2.fromOffset(0, 0)
            tab.Pages.Size = UDim2.fromScale(1, 1)
        end
    end
end

