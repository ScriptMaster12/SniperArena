-- ---------------------------------------------------------------- FPS boost (fully reversible)
xDTaraZ.Perf = { Saved = nil }

function xDTaraZ.Perf.Apply(enabled)
    local lighting = game:GetService("Lighting")
    if enabled then
        if not xDTaraZ.Perf.Saved then
            xDTaraZ.Perf.Saved = { Shadows = lighting.GlobalShadows }
            local okQuality, quality = pcall(function() return settings().Rendering.QualityLevel end)
            if okQuality then xDTaraZ.Perf.Saved.Quality = quality end
        end
        lighting.GlobalShadows = false
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    elseif xDTaraZ.Perf.Saved then
        local saved = xDTaraZ.Perf.Saved
        xDTaraZ.Perf.Saved = nil
        lighting.GlobalShadows = saved.Shadows
        if saved.Quality ~= nil then pcall(function() settings().Rendering.QualityLevel = saved.Quality end) end
    end
end

function xDTaraZ.Perf.Step()
    local want = xDTaraZ.Options.FpsBoost == true
    if want ~= (xDTaraZ.Perf.Saved ~= nil) then xDTaraZ.Perf.Apply(want) end
end

