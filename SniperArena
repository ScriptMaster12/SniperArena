                TweenService:Create(obj, info, { TextTransparency = 1 }):Play()
            end
        end

        -- A very soft status pulse; no spinning/glowing gimmicks.
        local pulse = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        TweenService:Create(statusDot, pulse, { BackgroundTransparency = 0.55 }):Play()

        parts.FadeIn()
    end)

    if not built then
        if parts.Gui then pcall(function() parts.Gui:Destroy() end) end
        return
    end

    xDTaraZ.Intro.Gui, xDTaraZ.Intro.Active = parts.Gui, true

    task.spawn(function()
        pcall(function()
            local started = osClock()
            local shown = 0
            local lastTick = started
            -- The bar always travels at a steady pace (about MIN_TIME seconds for the whole
            -- thing) and is only ever held back by real startup work that has not finished yet.
            -- It reaches 100% exactly when startup is done, so there is no stall near 90%.
            local MIN_TIME = 2.4
            local MAX_TIME = 20

            local phases = {
                { At = 0.00, Name = "Starting Kizzy Hub", Detail = "Checking environment..." },
                { At = 0.20, Name = "Loading services", Detail = "Connecting game modules..." },
                { At = 0.42, Name = "Preparing combat", Detail = "Setting up aim and visibility systems..." },
                { At = 0.64, Name = "Restoring settings", Detail = "Loading your saved preferences..." },
                { At = 0.84, Name = "Building interface", Detail = "Finishing the user interface..." },
                { At = 0.995, Name = "Ready", Detail = "Kizzy Hub is ready." },
            }

            while parts.Gui and parts.Gui.Parent do
                local now = osClock()
                local dt = math.min(now - lastTick, 0.1)
                lastTick = now
                local elapsed = now - started

                local done = xDTaraZ.Intro.Done
                local real = math.clamp((xDTaraZ.Banner.Done or 0) / math.max(xDTaraZ.Banner.Total or 1, 1), 0, 1)
                -- While real work is pending, creep a little ahead of it but never past 96%.
                local target = done and 1 or math.min(0.96, real * 0.9 + 0.12)

                if shown < target then
                    shown = math.min(target, shown + dt / MIN_TIME)
                end
                shown = math.clamp(shown, 0, 1)

                parts.Fill.Size = UDim2.fromScale(shown, 1)
                parts.Percent.Text = string.format("%d%%", math.floor(shown * 100 + 0.0001))

                local phase = phases[1]
                for _, item in ipairs(phases) do
                    if shown >= item.At then phase = item end
                end
                parts.Stage.Text = phase.Name
                local realLabel = xDTaraZ.Banner.LastLabel
                if realLabel and realLabel ~= "" and shown < 0.99 then
                    parts.Detail.Text = tostring(realLabel)
                else
                    parts.Detail.Text = phase.Detail
                end

                local activeStep = math.clamp(math.floor(shown * 5) + 1, 1, 5)
                for i, dot in ipairs(parts.StepDots) do
                    if i < activeStep then
                        dot.BackgroundColor3 = Color3.fromRGB(126, 92, 255)
                    elseif i == activeStep then
                        dot.BackgroundColor3 = Color3.fromRGB(80, 210, 255)
                    else
                        dot.BackgroundColor3 = Color3.fromRGB(55, 60, 77)
                    end
                end

                if done and shown >= 1 then break end
                if elapsed > MAX_TIME then break end
                task.wait()
            end

            parts.Fill.Size = UDim2.fromScale(1, 1)
            parts.Percent.Text = "100%"
            parts.Stage.Text = "Ready"
            parts.Detail.Text = "Kizzy Hub is ready."
            parts.StatusDot.BackgroundColor3 = Color3.fromRGB(74, 220, 145)
            for _, dot in ipairs(parts.StepDots) do
                dot.BackgroundColor3 = Color3.fromRGB(126, 92, 255)
            end

            task.wait(0.22)
            parts.FadeOut()
            task.wait(0.34)
        end)

        pcall(function()
            if parts.Gui then parts.Gui:Destroy() end
        end)
        xDTaraZ.Intro.Closed()
    end)
end

