---@return table  focused combatant entities (empty in lobby / combat paused)
function xDTaraZ.Entity.List()
    local service = xDTaraZ.Entity.Service()
    if not service then return {} end
    local ok, focused = pcall(function() return service.WorldManager:GetFocusedEntities() end)
    if not ok or type(focused) ~= "table" then return {} end
    return focused._items or focused.Items or focused
end

-- Broader entity collection used by 360 targeting. Some game builds expose
-- off-camera combatants outside GetFocusedEntities(), so try the common
-- world-manager collections and safely merge anything entity-shaped.
-- The merged entity list used to be rebuilt (new table + several pcalls) on every combat tick,
-- i.e. ~66 times a second. Entities are re-validated by every caller (IsEnemy), so a 0.1 s
-- snapshot is plenty and makes the combat loop much cheaper.
local entityAllCache = { At = -1, Value = nil }
function xDTaraZ.Entity.All()
    local now = osClock()
    local cached = entityAllCache.Value
    if cached and now - entityAllCache.At < 0.1 then return cached end
    local value = xDTaraZ.Entity.AllUncached()
    entityAllCache.At, entityAllCache.Value = now, value
    return value
end

function xDTaraZ.Entity.AllUncached()
    local service = xDTaraZ.Entity.Service()
    if not service then return xDTaraZ.Entity.List() end

    local merged, seen = {}, {}
    local function addCollection(collection)
        if type(collection) ~= "table" then return end
        local source = collection._items or collection.Items or collection.Entities or collection._entities or collection
        if type(source) ~= "table" then return end
        for _, entity in pairs(source) do
            if type(entity) == "table" and not seen[entity] then
                seen[entity] = true
                merged[#merged + 1] = entity
            end
        end
    end

    addCollection(xDTaraZ.Entity.List())

    local world = service.WorldManager
    if type(world) == "table" then
        for _, method in ipairs({ "GetEntities", "GetAllEntities", "GetAliveEntities" }) do
            local fn = world[method]
            if type(fn) == "function" then
                local ok, value = pcall(fn, world)
                if ok then addCollection(value) end
            end
        end
        addCollection(world.Entities)
        addCollection(world._entities)
        addCollection(world.Items)
        addCollection(world._items)
    end

    for _, method in ipairs({ "GetEntities", "GetAllEntities" }) do
        local fn = service[method]
        if type(fn) == "function" then
            local ok, value = pcall(fn, service)
            if ok then addCollection(value) end
        end
    end

    return #merged > 0 and merged or xDTaraZ.Entity.List()
end


-- ESP-only enhanced discovery. This intentionally does NOT feed the 15 ms
-- combat target loop; it is cached and only used by ESP to avoid the crashes
-- caused by aggressive whole-world combat scans.
xDTaraZ.Entity.ESPCache = { At = 0, Items = {} }

function xDTaraZ.Entity.VisualModel(entityModel)
    if not (entityModel and entityModel:IsA("Model")) then return nil end

    local function valid(model)
        if not (model and model:IsA("Model")) then return false end
        if model.Name == "Collider" or model.Name == "FreePart" then return false end
        local root = model:FindFirstChild("HumanoidRootPart")
        return root and root:IsA("BasePart")
    end

    if valid(entityModel) then return entityModel end

    local best, bestScore
    for _, descendant in ipairs(entityModel:GetDescendants()) do
        if descendant:IsA("Model") and valid(descendant) then
            local score = 0
            if descendant.Parent == entityModel then score += 20 end
            if descendant:FindFirstChild("Head") then score += 10 end
            if descendant:FindFirstChildOfClass("Humanoid") then score += 10 end
            if descendant:GetAttribute("UserId") ~= nil then score += 15 end
            if not bestScore or score > bestScore then
                best, bestScore = descendant, score
            end
        end
    end
    return best
end

function xDTaraZ.Entity.ESPList()
    -- ESP must not depend only on GetFocusedEntities(). That collection can be
    -- empty for replicated/off-camera players, which made the whole ESP appear broken.
    -- Always use the cached broad discovery path; it is throttled below so this stays cheap.
    local cache = xDTaraZ.Entity.ESPCache
    local now = osClock()
    local interval = Util.Number(xDTaraZ.Options.ESPDiscoveryInterval, 0.20, 0.08, 1)
    if now - (cache.At or 0) < interval and type(cache.Items) == "table" then
        return cache.Items
    end

    local result, seenCharacter = {}, {}

    local function addEntity(entity)
        if type(entity) ~= "table" then return end
        local char = xDTaraZ.Entity.Character(entity)
        if char and not seenCharacter[char] then
            seenCharacter[char] = true
            result[#result + 1] = entity
        end
    end

    -- Start with every entity the game service exposes, not just the focused subset.
    for _, entity in pairs(xDTaraZ.Entity.All()) do
        addEntity(entity)
    end

    local function addModel(entityModel, friendlyHint)
        if not (entityModel and entityModel:IsA("Model")) then return end
        local visual = xDTaraZ.Entity.VisualModel(entityModel)
        if not visual or seenCharacter[visual] then return end
        if visual == xDTaraZ.Player.Character or Players:GetPlayerFromCharacter(visual) == LocalPlayer then return end

        local humanoid = visual:FindFirstChildOfClass("Humanoid")
        local root = visual:FindFirstChild("HumanoidRootPart") or visual:FindFirstChild("Torso") or visual:FindFirstChild("UpperTorso")
        if not root or not root:IsA("BasePart") then return end

        local health = humanoid and humanoid.Health or tonumber(entityModel:GetAttribute("Health")) or 100
        local maxHealth = humanoid and humanoid.MaxHealth or tonumber(entityModel:GetAttribute("MaxHealth")) or 100
        if health <= 0 then return end

        seenCharacter[visual] = true
        result[#result + 1] = {
            Instance = entityModel,
            Character = visual,
            Humanoid = humanoid,
            Health = health,
            MaxHealth = maxHealth,
            _KizzyVisualProxy = true,
            _KizzyFriendly = friendlyHint,
        }
    end

    -- Standard Player.Character fallback. Some builds replicate the player model
    -- before EntityService adds it to its focused collection.
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local friendlyHint = nil
            if LocalPlayer.Team ~= nil and player.Team ~= nil then
                friendlyHint = player.Team == LocalPlayer.Team
            end
            addModel(player.Character, friendlyHint)
        end
    end

    -- The game's own Enemy/Friendly highlight holders are a reliable fallback
    -- when EntityService's focused list temporarily misses a replicated model.
    local highlights = Workspace:FindFirstChild("Highlight")
    if highlights then
        for _, spec in ipairs({
            { Name = "Enemy", Friendly = false },
            { Name = "Friendly", Friendly = true },
        }) do
            local group = highlights:FindFirstChild(spec.Name)
            local holder = group and (group:FindFirstChild("HighlightHolder") or group)
            if holder then
                for _, model in ipairs(holder:GetChildren()) do
                    if model:IsA("Model") then addModel(model, spec.Friendly) end
                end
            end
        end
    end

    -- Low-frequency Workspace.World discovery based on the alternate script.
    local world = Workspace:FindFirstChild("World")
    if world then
        for _, worldFolder in ipairs(world:GetChildren()) do
            local entities = worldFolder:FindFirstChild("Entities")
            if entities then
                for _, model in ipairs(entities:GetChildren()) do
                    if model:IsA("Model") and (model:GetAttribute("_entity") == "HumanoidEntity" or xDTaraZ.Entity.VisualModel(model)) then
                        addModel(model, nil)
                    end
                end
            end
        end
    end

    cache.At, cache.Items = now, result
    return result
end

function xDTaraZ.Entity.Local()
    local service = xDTaraZ.Entity.Service()
    if not service then return nil end
    local ok, entity = pcall(function() return service.GetLocalEntity() end)
    if ok and entity then return entity end
    ok, entity = pcall(function() return service:GetLocalEntity() end)
    return ok and entity or nil
end

local function TryCall(object, method)
    if type(object) ~= "table" and typeof(object) ~= "Instance" then return nil, false end
    local fn = object[method]
    if type(fn) ~= "function" then return nil, false end
    local ok, value = pcall(fn, object)
    if ok then return value, true end
    return nil, false
end

function xDTaraZ.Entity.IsLocal(entity)
    local value, called = TryCall(entity, "IsLocalEntity")
    if called then return value == true end
    return entity == xDTaraZ.Entity.Local()
end

---@return string?  per-round team tag, unique per player in FFA/Duel
function xDTaraZ.Entity.Team(entity)
    local inst = entity and entity.Instance
    if typeof(inst) == "Instance" then
        local team = inst:GetAttribute("Team")
        if team ~= nil then return tostring(team) end
    end
    local char = xDTaraZ.Entity.Character(entity)
    local team = char and char:GetAttribute("Team")
    return team ~= nil and tostring(team) or nil
end

-- Team data barely changes, so remember the answer for a quarter of a second per entity
-- instead of walking Workspace.Highlight on every single IsEnemy() call.
local friendlyCache = setmetatable({}, { __mode = "k" })
function xDTaraZ.Entity.Friendly(entity)
    if type(entity) ~= "table" then return xDTaraZ.Entity.FriendlyUncached(entity) end
    if entity._KizzyFriendly ~= nil then return entity._KizzyFriendly == true end
    local now = osClock()
    local hit = friendlyCache[entity]
    if hit and now - hit.At < 0.25 then return hit.Value end
    local value = xDTaraZ.Entity.FriendlyUncached(entity) == true
    friendlyCache[entity] = { Value = value, At = now }
    return value
end

function xDTaraZ.Entity.FriendlyUncached(entity)
    if type(entity) == "table" and entity._KizzyFriendly ~= nil then
        return entity._KizzyFriendly == true
    end
    local char = xDTaraZ.Entity.Character(entity)
    local marks = Workspace:FindFirstChild("Highlight")
    if char and marks then
        local friendly = marks:FindFirstChild("Friendly")
        if friendly and char:IsDescendantOf(friendly) then return true end
        if char:IsDescendantOf(marks) then return false end
    end

    if xDTaraZ.Match.ModeSet() ~= "TDM" then return false end
    local mine = xDTaraZ.Entity.Team(xDTaraZ.Entity.Local())
    local theirs = xDTaraZ.Entity.Team(entity)
    return mine ~= nil and mine == theirs
end

function xDTaraZ.Entity.Health(entity)
    if not entity then return 0, 0 end
    local health = entity.Health or select(1, TryCall(entity, "GetHealth")) or 0
    local maxHealth = entity.MaxHealth or select(1, TryCall(entity, "GetMaxHealth")) or 0
    return health, maxHealth
end

function xDTaraZ.Entity.Character(entity)
    local humanoid = entity and entity.Humanoid
    if humanoid and humanoid.Parent then return humanoid.Parent end
    return entity and entity.Character or nil
end

function xDTaraZ.Entity.Root(entity)
    local character = xDTaraZ.Entity.Character(entity)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head") or character.PrimaryPart
end

