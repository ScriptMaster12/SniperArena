local SKELETON_FALLBACK_CHAINS = {
    -- R15
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
    -- R6
    {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"}, {"Torso","Left Leg"}, {"Torso","Right Leg"},
}

local function skeletonPart(character, name)
    local direct = character:FindFirstChild(name)
    if direct and direct:IsA("BasePart") then return direct end
    local nested = character:FindFirstChild(name, true)
    return nested and nested:IsA("BasePart") and nested or nil
end

-- Build bones from the rig's real Motor6D joints. This works with custom/nested
-- character models instead of assuming that every game exposes stock R6/R15 names.
function xDTaraZ.Esp.SkeletonBones(character)
    local bones, seen = {}, {}
    if not character then return bones end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("Motor6D") then
            local a, b = object.Part0, object.Part1
            if a and b and a:IsA("BasePart") and b:IsA("BasePart")
                and a:IsDescendantOf(character) and b:IsDescendantOf(character)
            then
                seen[a] = seen[a] or {}
                if not seen[a][b] then
                    seen[a][b] = true
                    bones[#bones + 1] = { A = a, B = b }
                end
            end
        end
    end

    -- Some replicated visual rigs strip Motor6Ds. Fall back to recursive R15/R6
    -- lookup so nested body models still work.
    if #bones == 0 then
        for _, pair in ipairs(SKELETON_FALLBACK_CHAINS) do
            local a, b = skeletonPart(character, pair[1]), skeletonPart(character, pair[2])
            if a and b then bones[#bones + 1] = { A = a, B = b } end
        end
    end

    return bones
end

function xDTaraZ.Esp.Skeleton(character, needed)
    local skeleton = xDTaraZ.Esp.Skeletons[character]
    if not skeleton then
        skeleton = { Lines = {}, BoneCount = 0, RefreshAt = 0 }
        xDTaraZ.Esp.Skeletons[character] = skeleton
    end
    needed = math.max(tonumber(needed) or 0, 0)
    while #skeleton.Lines < needed do
        local line = Drawing.new("Line")
        line.Thickness = 1
        line.Transparency = 0.9
        line.Visible = false
        skeleton.Lines[#skeleton.Lines + 1] = line
    end
    return skeleton
end

function xDTaraZ.Esp.DrawSkeleton(character, minX, minY, maxX, maxY, color, opacity)
    -- Skeleton deliberately uses the SAME final screen-space rectangle as Box ESP.
    -- No Motor6D/rig/part discovery is involved here: if the box has valid bounds,
    -- the skeleton has valid points too.
    if not (character and character.Parent and minX and minY and maxX and maxY) then
        local existing = xDTaraZ.Esp.Skeletons[character]
        if existing then
            for _, line in ipairs(existing.Lines or {}) do line.Visible = false end
        end
        return
    end

    local w, h = maxX - minX, maxY - minY
    if w < 2 or h < 4 then
        local existing = xDTaraZ.Esp.Skeletons[character]
        if existing then
            for _, line in ipairs(existing.Lines or {}) do line.Visible = false end
        end
        return
    end

    local cx = (minX + maxX) * 0.5
    -- Proportions are tied to the target's projected rectangle, so they naturally
    -- get smaller with distance exactly like the 2D box.
    local head     = Vector2.new(cx,             minY + h * 0.08)
    local neck     = Vector2.new(cx,             minY + h * 0.20)
    local chest    = Vector2.new(cx,             minY + h * 0.36)
    local pelvis   = Vector2.new(cx,             minY + h * 0.57)
    local lShoulder= Vector2.new(cx - w * 0.25,  minY + h * 0.25)
    local rShoulder= Vector2.new(cx + w * 0.25,  minY + h * 0.25)
    local lElbow   = Vector2.new(cx - w * 0.40,  minY + h * 0.42)
    local rElbow   = Vector2.new(cx + w * 0.40,  minY + h * 0.42)
    local lHand    = Vector2.new(cx - w * 0.46,  minY + h * 0.58)
    local rHand    = Vector2.new(cx + w * 0.46,  minY + h * 0.58)
    local lKnee    = Vector2.new(cx - w * 0.14,  minY + h * 0.78)
    local rKnee    = Vector2.new(cx + w * 0.14,  minY + h * 0.78)
    local lFoot    = Vector2.new(cx - w * 0.19,  minY + h * 0.98)
    local rFoot    = Vector2.new(cx + w * 0.19,  minY + h * 0.98)

    local segments = {
        {head, neck}, {neck, chest}, {chest, pelvis},
        {neck, lShoulder}, {lShoulder, lElbow}, {lElbow, lHand},
        {neck, rShoulder}, {rShoulder, rElbow}, {rElbow, rHand},
        {pelvis, lKnee}, {lKnee, lFoot},
        {pelvis, rKnee}, {rKnee, rFoot},
    }

    local skeleton = xDTaraZ.Esp.Skeleton(character, #segments)
    local thickness = Util.Number(xDTaraZ.Options.ESPBoxThickness, 1, 1, 4)
    for i, segment in ipairs(segments) do
        local line = skeleton.Lines[i]
        line.From = segment[1]
        line.To = segment[2]
        line.Color = color
        line.Thickness = thickness
        line.Transparency = opacity
        line.Visible = true
    end
    for i = #segments + 1, #skeleton.Lines do
        skeleton.Lines[i].Visible = false
    end
end

function xDTaraZ.Esp.DestroyVerticalHealth(character)
    local health = xDTaraZ.Esp.VerticalHealth[character]
    if health then
        if health.Back then pcall(function() health.Back:Remove() end) end
        if health.Fill then pcall(function() health.Fill:Remove() end) end
    end
    xDTaraZ.Esp.VerticalHealth[character] = nil
end

