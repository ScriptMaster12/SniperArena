xDTaraZ.Scheduler = { Jobs = {}, Booted = false, LastErrors = {}, ErrorCount = 0 }

function xDTaraZ.Scheduler.Every(name, interval, fn)
    xDTaraZ.Scheduler.Jobs[name] = { Interval = interval, Fn = fn, Last = 0, Running = false, Failures = 0 }
end

-- A job that keeps failing used to warn() on every tick (the combat job ticks every ~15 ms), which
-- floods the console and costs frame time. Now it backs off (0.25s, 0.5s ... up to 5s), warns on the
-- first failure and then at most every 10 seconds, and the error is kept for the Health row.
function xDTaraZ.Scheduler.Step()
    local now = osClock()
    for name, job in pairs(xDTaraZ.Scheduler.Jobs) do
        if not job.Running and now - job.Last >= job.Interval then
            job.Last = now
            job.Running = true
            task.spawn(function()
                local ok, err = pcall(job.Fn)
                job.Running = false
                if ok then
                    job.Failures = 0
                    return
                end
                local scheduler = xDTaraZ.Scheduler
                job.Failures = (job.Failures or 0) + 1
                scheduler.ErrorCount += 1
                local previous = scheduler.LastErrors[name]
                scheduler.LastErrors[name] = { Message = tostring(err), At = osClock(), Count = (previous and previous.Count or 0) + 1 }
                job.Last = osClock() + math.min(5, 0.25 * 2 ^ (job.Failures - 1)) - job.Interval
                if job.Failures == 1 or osClock() - (job.WarnedAt or 0) > 10 then
                    job.WarnedAt = osClock()
                    warn("[SniperArena] job " .. name .. ": " .. tostring(err))
                end
            end)
        end
    end
end

