local function BuildInterface()
    xDTaraZ.Intro.Show()
    xDTaraZ.Banner.Step('Kizzy mobile UI')
    xDTaraZ.ConfigStore.StartupLoad()
    UI:SafeBuild()
    xDTaraZ.Banner.Step('Interface')
    task.defer(xDTaraZ.Boot)
end

function xDTaraZ.Boot()
    xDTaraZ:Connect(LocalPlayer.CharacterAdded, function(character)
        xDTaraZ.Movement.ResetSpin()
        xDTaraZ.TPKill.SetNoclip(false)
        table.clear(xDTaraZ.TPKill.NoclipParts)
        xDTaraZ.Player:Bind(character)
        xDTaraZ.Combat.OriginFn = nil
        xDTaraZ.Combat.OriginParams = nil
        xDTaraZ.Combat.OriginRetryAt = 0
    end)
    xDTaraZ:Connect(UserInputService.InputBegan, xDTaraZ.Keys.Handle)

    xDTaraZ.Movement.Start()
    xDTaraZ.Scheduler.Every("Combat", 0.015, xDTaraZ.Combat.Step)
    -- Instant native ESP: render visual positions on every displayed frame instead
    -- of a 0.15s scheduler tick. Expensive LOS raycasts remain cached inside ESP.
    xDTaraZ:Connect(RunService.RenderStepped, function()
        if xDTaraZ.State.Alive then xDTaraZ.Esp.Step() end
    end)
    xDTaraZ.Scheduler.Every("TPKill", 0.03, xDTaraZ.TPKill.Step)
    xDTaraZ.Scheduler.Every("TargetIndicator", 0.05, xDTaraZ.TargetIndicator.Step)
    xDTaraZ.Scheduler.Every("Crosshair", 0.03, xDTaraZ.Crosshair.Step)
    xDTaraZ.Scheduler.Every("Session", 1, xDTaraZ.Session.Step)
    xDTaraZ.Scheduler.Every("Economy", xDTaraZ.Config.EconomyInterval, xDTaraZ.Economy.Step)
    xDTaraZ.Scheduler.Every("AutoOpenCases", 1, xDTaraZ.Shop.Step)
    xDTaraZ.Scheduler.Every("AutoSell", math.max(0.5, xDTaraZ.Config.SellDelay), xDTaraZ.Sell.Step)
    xDTaraZ.Scheduler.Every("AutoClaimQuest", 2, xDTaraZ.Collect.Step)
    xDTaraZ.Scheduler.Every("FPSBoost", 0.5, xDTaraZ.Perf.Step)
    xDTaraZ.Scheduler.Every("Protections", 0.25, xDTaraZ.Protections.Step)
    xDTaraZ.Scheduler.Every("AutoSave", 0.5, xDTaraZ.AutoSave.Step)
    xDTaraZ.Scheduler.Every("AntiAfk", 5, xDTaraZ.Player.AntiAfk.Step)
    xDTaraZ.Scheduler.Every("Respawn", 0.1, xDTaraZ.Player.Respawn.Step)
    xDTaraZ.Scheduler.Every("AutoHide", 0.5, function() xDTaraZ.UI:AutoHideStep() end)
    xDTaraZ.Scheduler.Boot()
    if xDTaraZ.Options.AutoSaveOnJoin then
        task.delay(2, function()
            if xDTaraZ.State.Alive and not xDTaraZ.ConfigStore.StartupFailed then xDTaraZ.ConfigStore.Save() end
        end)
    end
    xDTaraZ.Banner.Step("Combat systems online")
    xDTaraZ.Banner.Ready()
    xDTaraZ.Intro.Finish()
end

function xDTaraZ:Unload()
    if xDTaraZ.Options.AutoSaveOnUnload and xDTaraZ.ConfigStore then pcall(xDTaraZ.ConfigStore.Save) end
    self.State.Alive = false
    if xDTaraZ.UI then xDTaraZ.UI:ClearConnections() end
    xDTaraZ.TPKill.SetNoclip(false)
    xDTaraZ.Movement.Stop()
    xDTaraZ.Options.FpsBoost = false
    xDTaraZ.Perf.Apply(false)
    xDTaraZ.TargetIndicator.Clear()
    xDTaraZ.Crosshair.Clear()
    xDTaraZ.Combat.Unload()
    xDTaraZ.Esp.Clear()
    if xDTaraZ.Intro.Gui then pcall(function() xDTaraZ.Intro.Gui:Destroy() end) end
    for _, connection in ipairs(self.State.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(self.State.Connections)
end

environment.SniperArenaUnload = function()
    if xDTaraZ.UI and xDTaraZ.UI.Gui then pcall(function() xDTaraZ.UI.Gui:Destroy() end) end
    xDTaraZ:Unload()
end

if LocalPlayer.Character then
    xDTaraZ.Player:Bind(LocalPlayer.Character)
end

xDTaraZ.Banner.Step("Character bound")
BuildInterface()

