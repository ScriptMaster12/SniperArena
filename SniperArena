-- ---------------------------------------------------------------- diagnostics
xDTaraZ.Diag = {}

function xDTaraZ.Diag.GetStatus()
    local newest, newestName
    for name, info in pairs(xDTaraZ.Scheduler.LastErrors) do
        if osClock() - info.At < 30 and (not newest or info.At > newest.At) then newest, newestName = info, name end
    end
    if not newest then return "All systems OK" end
    return string.format("%s failing (x%d)", newestName, newest.Count)
end

---@return string  everything useful for a bug report, ready to paste
function xDTaraZ.Diag.Report()
    local okExec, executor = pcall(identifyexecutor)
    local lines = {
        string.format("%s v%s", xDTaraZ.Build.Name, xDTaraZ.Build.Version),
        "Executor: " .. (okExec and tostring(executor) or "unknown"),
        "Place: " .. tostring(game.PlaceId) .. "  Job: " .. tostring(game.JobId),
        string.format("Session: %d FPS, ping %s", xDTaraZ.Session.Fps, tostring(xDTaraZ.Session.Ping)),
    }
    local caps = {}
    for name, has in pairs(xDTaraZ.Caps) do caps[#caps + 1] = name .. "=" .. (has and "yes" or "no") end
    table.sort(caps)
    lines[#lines + 1] = "Caps: " .. table.concat(caps, ", ")
    local names = {}
    for name in pairs(xDTaraZ.Scheduler.LastErrors) do names[#names + 1] = name end
    table.sort(names)
    if #names == 0 then
        lines[#lines + 1] = "Job errors: none"
    else
        for _, name in ipairs(names) do
            local info = xDTaraZ.Scheduler.LastErrors[name]
            lines[#lines + 1] = string.format("Job error [%s] x%d: %s", name, info.Count, info.Message)
        end
    end
    return table.concat(lines, "\n")
end

