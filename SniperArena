local function New(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function Corner(obj, px) New('UICorner', {CornerRadius = UDim.new(0, px or 10)}, obj) end
local function Stroke(obj, color, t) New('UIStroke', {Color=color or C.Stroke, Thickness=t or 1, Transparency=.15}, obj) end
local function Subtle(obj) New('UIStroke',{Color=C.Stroke,Thickness=1,Transparency=.55,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},obj) end
local function Hover(obj, base, over)
    -- touch screens never send MouseLeave, so hover colours would get stuck there
    if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then return end
    obj.MouseEnter:Connect(function() UI:Tween(obj,{BackgroundColor3=over},.12) end)
    obj.MouseLeave:Connect(function() UI:Tween(obj,{BackgroundColor3=base},.12) end)
end
local function Pad(obj, l,t,r,b) New('UIPadding',{PaddingLeft=UDim.new(0,l),PaddingTop=UDim.new(0,t),PaddingRight=UDim.new(0,r),PaddingBottom=UDim.new(0,b)},obj) end
local function Label(parent, props)
