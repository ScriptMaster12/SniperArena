function xDTaraZ.TargetIndicator.Set(entity, mode)
    local indicator = xDTaraZ.TargetIndicator
    local root = entity and xDTaraZ.Entity.Root(entity)
    local char = entity and xDTaraZ.Entity.Character(entity)
    if not (root and root.Parent and char) then
        xDTaraZ.TargetIndicator.Clear()
        return
    end

    if indicator.Target ~= entity or not indicator.Gui or not indicator.Gui.Parent then
        xDTaraZ.TargetIndicator.Clear()

        local gui = Instance.new("BillboardGui")
        gui.Name = "KizzyTargetLock"
        gui.Size = UDim2.fromOffset(190, 46)
        gui.StudsOffset = Vector3.new(0, 3.6, 0)
        gui.AlwaysOnTop = true
        gui.Adornee = root
        gui.Parent = Util.Hui()

        local label = Instance.new("TextLabel")
        label.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
        label.BackgroundTransparency = 0.15
        label.BorderSizePixel = 0
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Color3.fromRGB(255, 210, 90)
        label.TextStrokeTransparency = 0.7
        label.TextSize = 13
        label.TextWrapped = true
        label.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = label

        indicator.Gui, indicator.Label, indicator.Adornee = gui, label, root
        indicator.Target = entity
    end

    indicator.Mode = mode

    local health, maxHealth = xDTaraZ.Entity.Health(entity)
    local myRoot = xDTaraZ.Player.Root
    local distance = myRoot and (root.Position - myRoot.Position).Magnitude or 0
    local hp = maxHealth > 0 and math.floor(health / maxHealth * 100 + 0.5) or math.floor(health)

    indicator.Gui.Adornee = root
    indicator.Label.Text = string.format("%s LOCK\n%s · %d%% HP · %dm", mode, char.Name, hp, math.floor(distance + 0.5))
end

function xDTaraZ.TargetIndicator.Step()
    if not xDTaraZ.Options.ShowTargetIndicator then
        xDTaraZ.TargetIndicator.Clear()
        return
    end

    if xDTaraZ.Options.TPKill and xDTaraZ.TPKill.Target then
        xDTaraZ.TargetIndicator.Set(xDTaraZ.TPKill.Target, "FLY KILL")
        return
    end

    local rageTarget = xDTaraZ.Combat.FireTarget or xDTaraZ.Combat.Target
    if xDTaraZ.Options.Ragebot and rageTarget then
        xDTaraZ.TargetIndicator.Set(rageTarget, "RAGE")
        return
    end

    xDTaraZ.TargetIndicator.Clear()
end

