    local claimed = 0
    for _, id in ipairs(ids) do
        local ok = pcall(function() return service.ClaimReward(id) end)
        if ok then claimed += 1 end
        task.wait(xDTaraZ.Config.ClaimDelay)
    end
    xDTaraZ.Collect.LastResult = claimed .. " quests claimed"
