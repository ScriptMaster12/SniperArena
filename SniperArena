---@return number?, number?, number?, number?  projected 2D bounds
function xDTaraZ.Esp.ScreenBounds(character, cam)
    if not (character and cam) then return nil end
    local ok, cf, size = pcall(character.GetBoundingBox, character)
    if not ok or not cf or not size then return nil end
    local half = size * 0.5
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local allInFront = true
    for _, sx in ipairs({ -1, 1 }) do
        for _, sy in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                local screen = cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(sx * half.X, sy * half.Y, sz * half.Z)))
                if screen.Z <= 0 then
                    allInFront = false
                else
                    minX, maxX = math.min(minX, screen.X), math.max(maxX, screen.X)
                    minY, maxY = math.min(minY, screen.Y), math.max(maxY, screen.Y)
                end
            end
        end
    end
    if not allInFront or maxX <= minX or maxY <= minY then return nil end
    return minX, minY, maxX, maxY
end

function xDTaraZ.Esp.DrawColor(friendly, visible)
    if friendly then return Color3.fromRGB(80, 160, 255) end
    if xDTaraZ.Options.ESPRainbow then
        return Color3.fromHSV((os.clock() * 0.5) % 1, 1, 1)
    end
    return visible and Color3.fromRGB(80, 235, 135) or Color3.fromRGB(255, 80, 90)
end

-- Real line-of-sight check used for ESP coloring and the Visible ESP Only filter.
-- Visible enemies are green; enemies behind cover stay red.
function xDTaraZ.Esp.HasLineOfSight(root, character)
    local cam = Workspace.CurrentCamera
    if not (cam and root and character) then return false end
    espParams.FilterDescendantsInstances = { cam, xDTaraZ.Player.Character }
    local origin = cam.CFrame.Position
    local hit = Workspace:Raycast(origin, root.Position - origin, espParams)
    -- No hit means nothing blocked the ray before the target point. Some character
    -- parts have CanQuery disabled, so requiring a hit on the character incorrectly
    -- marked clear targets as hidden.
    return hit == nil or hit.Instance:IsDescendantOf(character)
end

function xDTaraZ.Esp.CachedLineOfSight(root, character)
    local now = osClock()
    local cached = xDTaraZ.Esp.VisibilityCache[character]
    if cached and now < cached.Next then return cached.Value end
    local value = xDTaraZ.Esp.HasLineOfSight(root, character)
    xDTaraZ.Esp.VisibilityCache[character] = {Value=value, Next=now + 0.30}
    return value
end

function xDTaraZ.Esp.Visible(root, character)
    if not xDTaraZ.Options.ESPVisibleOnly then return true end
    return xDTaraZ.Esp.CachedLineOfSight(root, character)
end

function xDTaraZ.Esp.Clear()
    for character in pairs(xDTaraZ.Esp.Highlights) do xDTaraZ.Esp.DestroyHighlight(character) end
    for character, tag in pairs(xDTaraZ.Esp.Tags) do
        if tag and tag.Gui then pcall(function() tag.Gui:Destroy() end) end
        xDTaraZ.Esp.Tags[character] = nil
    end
    for character in pairs(xDTaraZ.Esp.Tracers) do xDTaraZ.Esp.DestroyTracer(character) end
    for character in pairs(xDTaraZ.Esp.Boxes) do xDTaraZ.Esp.DestroyBox(character) end
    for character in pairs(xDTaraZ.Esp.Skeletons) do xDTaraZ.Esp.DestroySkeleton(character) end
    for character in pairs(xDTaraZ.Esp.Arrows) do xDTaraZ.Esp.DestroyArrow(character) end
    for character in pairs(xDTaraZ.Esp.VerticalHealth) do xDTaraZ.Esp.DestroyVerticalHealth(character) end
    if xDTaraZ.Esp.OverlayGui then pcall(function() xDTaraZ.Esp.OverlayGui:Destroy() end); xDTaraZ.Esp.OverlayGui=nil end
    xDTaraZ.Esp.VisibilityCache = {}
    xDTaraZ.Esp.SkeletonNext = {}
    xDTaraZ.Esp.Count = 0
end

