    if dash and dash.RefreshNextDashTime then pcall(dash.RefreshNextDashTime) end
end

function xDTaraZ.Movement.ResetSpin()
    local movement = xDTaraZ.Movement
    local humanoid = movement.SpinHumanoid
    if humanoid and humanoid.Parent and movement.SpinAutoRotate ~= nil then
        pcall(function() humanoid.AutoRotate = movement.SpinAutoRotate end)
    end
    movement.SpinHumanoid = nil
    movement.SpinAutoRotate = nil
end

function xDTaraZ.Movement.SpinStep(dt)
    local movement = xDTaraZ.Movement
    if not (xDTaraZ.State.Alive and xDTaraZ.Options.SpinBot) then
        if movement.SpinHumanoid then movement.ResetSpin() end
        return
    end

    local root = xDTaraZ.Player.Root
    local humanoid = xDTaraZ.Player.Humanoid
    if not (root and root.Parent and humanoid and humanoid.Parent and humanoid.Health > 0) then
        movement.ResetSpin()
        return
    end

    if movement.SpinHumanoid ~= humanoid then
        movement.ResetSpin()
        movement.SpinHumanoid = humanoid
        movement.SpinAutoRotate = humanoid.AutoRotate
        humanoid.AutoRotate = false
        local _, y = root.CFrame:ToEulerAnglesYXZ()
        movement.SpinAngle = y or 0
    end

    local cam = Workspace.CurrentCamera
    local savedCamera = cam and cam.CFrame
    local speed = math.rad(Util.Number(xDTaraZ.Options.SpinSpeed, 720, 90, 2160))
    movement.SpinAngle = (movement.SpinAngle + speed * math.max(tonumber(dt) or 0, 0)) % (math.pi * 2)

    local position = root.Position
    root.CFrame = CFrame.new(position) * CFrame.Angles(0, movement.SpinAngle, 0)

    -- Preserve the player's view. Aimbot runs one render-priority step after
    -- Spin Bot and can still turn the camera toward its target normally.
    if cam and savedCamera then cam.CFrame = savedCamera end
end

function xDTaraZ.Movement.Start()
    if xDTaraZ.Movement.Booted then return end
    xDTaraZ.Movement.Booted = true
    xDTaraZ:Connect(RunService.Stepped, xDTaraZ.Movement.OnStepped)
    RunService:BindToRenderStep("xDTaraZSpinBot", xDTaraZ.Config.AimRenderPriority - 1, xDTaraZ.Movement.SpinStep)
end

function xDTaraZ.Movement.Stop()
    pcall(RunService.UnbindFromRenderStep, RunService, "xDTaraZSpinBot")
    xDTaraZ.Movement.ResetSpin()
    xDTaraZ.Movement.Booted = false
end

function xDTaraZ.Movement.GetStatus()
    local active = {}
    if xDTaraZ.Options.InfiniteDash then active[#active + 1] = "Infinite dash" end
    if xDTaraZ.Options.SpinBot then active[#active + 1] = "Spin bot" end
    return #active > 0 and table.concat(active, " · ") or "Off"
end

