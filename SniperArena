xDTaraZ.TargetIndicator = { Gui = nil, Label = nil, Adornee = nil, Target = nil, Mode = nil }

function xDTaraZ.TargetIndicator.Clear()
    local indicator = xDTaraZ.TargetIndicator
    if indicator.Gui then
        pcall(function() indicator.Gui:Destroy() end)
    end
    indicator.Gui, indicator.Label, indicator.Adornee = nil, nil, nil
    indicator.Target, indicator.Mode = nil, nil
