function UI:MakeSwitch(parent, label, desc, getter, onClick, searchKey)
    local descH=desc and self:DescHeight(desc,self:BodyWidth()-76,10) or 0
    local height=desc and math.max(44,29+descH+8) or 44
    local row=New('TextButton',{AutoButtonColor=false,Text='',BackgroundColor3=C.Card,Size=UDim2.new(1,0,0,height)},parent); Corner(row,9); Subtle(row); Hover(row,C.Card,C.CardHover)
    Label(row,{Position=UDim2.fromOffset(14,desc and 6 or 0),Size=UDim2.new(1,-76,0,desc and 20 or height),Font=Enum.Font.GothamMedium,Text=label,TextColor3=C.Text,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left})
    if desc then Label(row,{Position=UDim2.fromOffset(14,26),Size=UDim2.new(1,-76,0,descH),Font=Enum.Font.Gotham,Text=desc,TextWrapped=true,TextColor3=C.Muted,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top}) end
    local pill,dot=Pill(row)
    local shown
    local function paint(v,instant)
        local color,position=v and C.Good or C.Off, v and UDim2.fromOffset(21,3) or UDim2.fromOffset(3,3)
        if instant or shown==nil then pill.BackgroundColor3=color; dot.Position=position
        elseif shown~=v then self:Tween(pill,{BackgroundColor3=color},.16); self:Tween(dot,{Position=position},.22,Enum.EasingStyle.Back) end
        shown=v
    end
    paint(getter()==true,true)
    row.Activated:Connect(function() local v=onClick(); paint(v) end)
    return row,paint
end

