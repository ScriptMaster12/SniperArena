-- ---------------------------------------------------------------- session stats
local function DurationText(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours, minutes = math.floor(seconds / 3600), math.floor(seconds % 3600 / 60)
    if hours > 0 then return string.format("%dh %02dm", hours, minutes) end
    return string.format("%dm %02ds", minutes, seconds % 60)
end

function xDTaraZ.Economy.PlaytimeText()
    return DurationText(osClock() - xDTaraZ.Session.Started)
end

-- Coins per hour since the session counter was last reset.
function xDTaraZ.Economy.PerHourText()
    local e = xDTaraZ.Economy
    local elapsed = osClock() - (e.StartedAt or osClock())
    if elapsed < 60 then return "measuring..." end
    local perHour = e.Earned / (elapsed / 3600)
    return (perHour >= 0 and "+" or "-") .. Util.FormatNumber(math.abs(perHour)) .. " / hour"
end

-- ---------------------------------------------------------------- Discord session summary
-- The link is yours: nothing is built in. It lives in the small meta file next to your profiles and
-- is never written into profile files, exported configs or the "changes" list, and a pasted config
-- cannot set it.
xDTaraZ.Webhook = { LastSentAt = -100 }

function xDTaraZ.Webhook.Valid(url)
    if type(url) ~= "string" then return false end
    local host = url:match("^https://([^/]+)/api/webhooks/%d+/[%w_%-]+$")
    if not host or not host:match("^[%w%.%-]+$") then return false end
    host = string.lower(host)
    return host == "discord.com" or host == "discordapp.com"
        or host:match("%.discord%.com$") ~= nil or host:match("%.discordapp%.com$") ~= nil
end

function xDTaraZ.Webhook.Describe()
    local url = xDTaraZ.Options.WebhookUrl
    if not xDTaraZ.Webhook.Valid(url) then return "Not set" end
    return "Saved (ends ..." .. url:sub(-4) .. ")"
end

function xDTaraZ.Webhook.Payload(reason)
    local e = xDTaraZ.Economy
    return {
        username = "Kizzy Hub",
        embeds = { {
            title = "Sniper Arena session" .. (reason == "unload" and " (hub unloaded)" or ""),
            color = 8280319,
            fields = {
                { name = "Player", value = LocalPlayer.Name, inline = true },
                { name = "Time played", value = xDTaraZ.Economy.PlaytimeText(), inline = true },
                { name = "Coins", value = Util.FormatNumber(e.Coins), inline = true },
                { name = "Earned", value = xDTaraZ.Economy.EarnedText(), inline = true },
                { name = "Rate", value = xDTaraZ.Economy.PerHourText(), inline = true },
                { name = "Cases owned", value = Util.FormatNumber(e.Cases), inline = true },
                { name = "Inventory", value = xDTaraZ.Economy.InventoryText(), inline = false },
            },
        } },
    }
end

---@return boolean, string
function xDTaraZ.Webhook.Send(reason, force)
    local url = xDTaraZ.Options.WebhookUrl
    if not xDTaraZ.Webhook.Valid(url) then return false, "Save a Discord webhook link first" end
    if not Util.Request then return false, "This executor has no HTTP request function" end
    if not force and osClock() - xDTaraZ.Webhook.LastSentAt < 5 then return false, "Wait a few seconds between sends" end
    xDTaraZ.Webhook.LastSentAt = osClock()
    local okBody, body = pcall(HttpService.JSONEncode, HttpService, xDTaraZ.Webhook.Payload(reason))
    if not okBody then return false, "Could not build the message" end
    local okRequest, response = pcall(Util.Request, {
        Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body,
    })
    if not okRequest or type(response) ~= "table" then return false, "Request failed" end
    local code = tonumber(response.StatusCode)
    if response.Success == true or (code and code >= 200 and code < 300) then return true, "Summary sent" end
    return false, code and ("Discord answered " .. code) or "No response from Discord"
end

-- ---------------------------------------------------------------- what differs from the defaults
local function DiffValueText(value)
    if type(value) == "boolean" then return value and "ON" or "OFF" end
    if type(value) == "table" then
        local names = {}
        for key, entry in pairs(value) do
            if entry then names[#names + 1] = tostring(type(key) == "number" and entry or key) end
        end
        table.sort(names)
        return #names > 0 and table.concat(names, ", ") or "none"
    end
    return tostring(value)
end

---@return string[]  one "Setting: default -> now" line per setting you have changed
function xDTaraZ.ConfigStore.Diff()
    local defaults = xDTaraZ.ConfigStore.DefaultOptions or {}
    local keys = {}
    for key in pairs(defaults) do keys[#keys + 1] = key end
    table.sort(keys)
    local skip = { ConfigProfile = true, WebhookUrl = true }
    local lines = {}
    for _, key in ipairs(keys) do
        if not skip[key] then
            local was, now = DiffValueText(defaults[key]), DiffValueText(xDTaraZ.Options[key])
            if was ~= now then lines[#lines + 1] = key .. ": " .. was .. " -> " .. now end
        end
    end
    return lines
end

