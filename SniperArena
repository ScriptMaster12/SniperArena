xDTaraZ.Server = { Status = "Idle" }

function xDTaraZ.Server.Rejoin()
    local ok, err = pcall(function()
        local service = game:GetService("TeleportService")
        if #Players:GetPlayers() <= 1 then
            service:Teleport(game.PlaceId, LocalPlayer)
        else
            service:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end
    end)
    xDTaraZ.Server.Status = ok and "Rejoining..." or ("Rejoin failed: " .. tostring(err))
    return ok, xDTaraZ.Server.Status
end

---@param mode string  "small" picks one of the 5 emptiest servers, anything else is random
---@return table?, string?  server {Id, Playing, Max}, or nil and the reason
function xDTaraZ.Server.Find(mode)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    local okGet, body = pcall(Util.HttpGet, url)
    if not okGet then return nil, "Server list unavailable" end
    local okJson, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not okJson or type(data) ~= "table" or type(data.data) ~= "table" then return nil, "Bad server list" end

    local candidates = {}
    for _, server in ipairs(data.data) do
        local playing, maxPlayers = tonumber(server.playing), tonumber(server.maxPlayers)
        if server.id and server.id ~= game.JobId and playing and maxPlayers and playing < maxPlayers then
            candidates[#candidates + 1] = { Id = server.id, Playing = playing, Max = maxPlayers }
        end
    end
    if #candidates == 0 then return nil, "No other server found" end
    if mode == "small" then
        table.sort(candidates, function(a, b) return a.Playing < b.Playing end)
        return candidates[math.random(math.min(#candidates, 5))]
    end
    return candidates[math.random(#candidates)]
end

function xDTaraZ.Server.Hop(mode)
    local server, reason = xDTaraZ.Server.Find(mode)
    if not server then
        xDTaraZ.Server.Status = reason
        return false, reason
    end
    local ok, err = pcall(function()
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, server.Id, LocalPlayer)
    end)
    xDTaraZ.Server.Status = ok and string.format("Hopping to a %d/%d server", server.Playing, server.Max)
        or ("Hop failed: " .. tostring(err))
    return ok, xDTaraZ.Server.Status
end

function xDTaraZ.Server.JoinScript()
    return string.format("game:GetService('TeleportService'):TeleportToPlaceInstance(%d, '%s', game.Players.LocalPlayer)",
        game.PlaceId, tostring(game.JobId))
end

