function UI:Slider(parent,key,label,min,max,step,suffix,desc)
    step=(step and step>0) and step or 1
    local decimals=0
    local fraction=tostring(step):match('%.(%d+)')
    if fraction then decimals=#fraction end
    local function fmt(v) return decimals>0 and string.format('%.'..decimals..'f',v) or tostring(math.floor(v+.5)) end

    local descH=desc and self:DescHeight(desc,self:BodyWidth()-28,10) or 0
    local barY=desc and (29+descH+8) or 40
