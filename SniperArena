-- Height of a wrapped description label (so long descriptions are never cut off).
function UI:DescHeight(text,width,size)
    text=tostring(text or ''); size=size or 10
    if text=='' then return 0 end
    width=math.max(60,width)
    local ok,bounds=pcall(function()
        return TextService:GetTextSize(text,size,Enum.Font.Gotham,Vector2.new(width,10000))
    end)
    if ok and bounds then return math.ceil(bounds.Y)+2 end
    return math.ceil(#text*size*.55/width)*(size+2)+2
end

