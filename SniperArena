xDTaraZ.TPKill = { Target = nil, Status = "Off", NoclipParts = {}, NextTargetAt = 0 }

-- Shared noclip state. Standalone Noclip can stay enabled even when Fly Kill is off.
-- Original collision states are saved so they can be restored exactly.
function xDTaraZ.TPKill.SetNoclip(enabled)
    local character = xDTaraZ.Player.Character

    if not enabled then
        for part, originalCanCollide in pairs(xDTaraZ.TPKill.NoclipParts) do
            if typeof(part) == "Instance" and part.Parent then
                pcall(function() part.CanCollide = originalCanCollide end)
            end
            xDTaraZ.TPKill.NoclipParts[part] = nil
        end
        return
    end

    if not character or not character.Parent then return end

    -- Re-apply every step so newly-added character parts are also noclipped.
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if xDTaraZ.TPKill.NoclipParts[object] == nil then
                xDTaraZ.TPKill.NoclipParts[object] = object.CanCollide
            end
            object.CanCollide = false
        end
    end
end

function xDTaraZ.TPKill.NoclipWanted(flyActive)
    return xDTaraZ.Options.Noclip == true
        or (flyActive and xDTaraZ.Options.FlyKillNoclip == true)
end

---@param excluded table? entity to skip while fast-retargeting
function xDTaraZ.TPKill.FindTarget(excluded)
    local myRoot = xDTaraZ.Player.Root
    local priority = xDTaraZ.Options.FlyKillPriority or "Closest"
    local best, bestRoot, bestScore, bestDistance

    for _, entity in pairs(xDTaraZ.Entity.List()) do
        if entity ~= excluded and xDTaraZ.Combat.IsEnemy(entity) then
            local root = xDTaraZ.Entity.Root(entity)
            if root and root.Parent then
                local distance = myRoot and (root.Position - myRoot.Position).Magnitude or math.huge
                local health = select(1, xDTaraZ.Entity.Health(entity))
                local score = priority == "Lowest Health" and health or distance

                if bestScore == nil
                    or score < bestScore
                    or (score == bestScore and (bestDistance == nil or distance < bestDistance))
                then
                    best, bestRoot, bestScore, bestDistance = entity, root, score, distance
                end
            end
        end
    end

    return best, bestRoot
end

function xDTaraZ.TPKill.Step()
    local o = xDTaraZ.Options

    if not o.TPKill then
        xDTaraZ.TPKill.SetNoclip(xDTaraZ.TPKill.NoclipWanted(false))
        xDTaraZ.TPKill.Target = nil
        xDTaraZ.TPKill.Status = "Off"
        return
    end

    if not xDTaraZ.Player:IsAlive() or not xDTaraZ.Match.InRound() then
        xDTaraZ.TPKill.SetNoclip(xDTaraZ.TPKill.NoclipWanted(false))
        xDTaraZ.TPKill.Target = nil
        xDTaraZ.TPKill.Status = "Waiting for round"
        return
    end

    local target = xDTaraZ.TPKill.Target
    if not target or not xDTaraZ.Combat.IsEnemy(target) then
        if os.clock() >= (xDTaraZ.TPKill.NextTargetAt or 0) then
            target = select(1, xDTaraZ.TPKill.FindTarget())
            xDTaraZ.TPKill.Target = target
        else
            target = nil
        end
    end

    if not target then
        xDTaraZ.TPKill.SetNoclip(xDTaraZ.TPKill.NoclipWanted(false))
        local left = math.max(0, (xDTaraZ.TPKill.NextTargetAt or 0) - os.clock())
        xDTaraZ.TPKill.Status = left > 0 and string.format("Switching · %.2fs", left) or "No enemies"
        return
    end

    local targetRoot = xDTaraZ.Entity.Root(target)
    local myRoot = xDTaraZ.Player.Root
    local part = xDTaraZ.Combat.HitPart(target, o.AimBone or "Head")
    if not (targetRoot and myRoot and part) then
        xDTaraZ.TPKill.SetNoclip(xDTaraZ.TPKill.NoclipWanted(false))
        xDTaraZ.TPKill.Target = nil
        return
    end

    xDTaraZ.TPKill.SetNoclip(xDTaraZ.TPKill.NoclipWanted(true))

    local followDistance = math.clamp(tonumber(o.FlyKillDistance) or 5, 1, 20)
    local followHeight = math.clamp(tonumber(o.FlyKillHeight) or 2.5, 0, 15)
    local destination = targetRoot.Position - targetRoot.CFrame.LookVector * followDistance + Vector3.new(0, followHeight, 0)
    local offset = destination - myRoot.Position
    local distance = offset.Magnitude
    local speed = math.clamp(tonumber(o.FlyKillSpeed) or 70, 20, 140)
    local smooth = math.clamp(tonumber(o.FlyKillSmooth) or 35, 0, 95)
    local response = math.clamp(1 - smooth / 100, 0.05, 1)

    local desiredVelocity
    if distance > 2.25 then
        desiredVelocity = offset.Unit * math.min(speed, math.max(22, distance * 3))
    else
        desiredVelocity = targetRoot.AssemblyLinearVelocity
    end
    myRoot.AssemblyLinearVelocity = myRoot.AssemblyLinearVelocity:Lerp(desiredVelocity, response)
    myRoot.AssemblyAngularVelocity = Vector3.zero

    local char = xDTaraZ.Entity.Character(target)
    local targetName = char and char.Name or "enemy"
    local priorityName = o.FlyKillPriority or "Closest"
    local noclipText = xDTaraZ.TPKill.NoclipWanted(true) and " · Noclip" or ""
    xDTaraZ.TPKill.Status = (distance > 2.25 and "Flying to " or "Attacking ") .. targetName .. " · " .. priorityName .. noclipText

    local _, shooter = xDTaraZ.Combat.Shooter()
    if shooter then
        local now = os.clock()
        if now - xDTaraZ.Combat.LastShot >= xDTaraZ.Config.FireInterval then
            local params = xDTaraZ.Combat.OriginOverride()
            if params and type(shooter.Shoot) == "function" then
                xDTaraZ.Combat.LastShot = now
                xDTaraZ.Combat.ShootAt(shooter, target, part, {})
            else
                local cam = Workspace.CurrentCamera
                if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, part.Position) end
                xDTaraZ.Combat.Fire()
            end
        end
    end

    if not xDTaraZ.Combat.IsEnemy(target) then
        local delay = math.max(0, tonumber(o.TargetSwitchDelay) or 0) / 1000
        xDTaraZ.TPKill.NextTargetAt = os.clock() + delay
        if delay <= 0 then
            local nextTarget = select(1, xDTaraZ.TPKill.FindTarget(target))
            xDTaraZ.TPKill.Target = nextTarget
            if nextTarget then
                local nextChar = xDTaraZ.Entity.Character(nextTarget)
                xDTaraZ.TPKill.Status = "Switching to " .. (nextChar and nextChar.Name or "enemy")
            end
        else
            xDTaraZ.TPKill.Target = nil
            xDTaraZ.TPKill.Status = string.format("Switching · %.2fs", delay)
        end
    end
end

function xDTaraZ.TPKill.GetStatus()
    return xDTaraZ.TPKill.Status
end

