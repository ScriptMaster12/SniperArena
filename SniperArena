-- Turns the cheat/automation switches off. Filters and settings are left alone.
function UI:Panic()
    local count=0
    for _,key in ipairs(xDTaraZ.PanicKeys) do
        if xDTaraZ.Options[key]==true then
            self:SetOption(key,false)
            if self.Controls[key] and self.Controls[key].Set then self.Controls[key].Set(false) end
            count+=1
        end
    end
    self:Toast('Kizzy Hub',count>0 and (count..' feature'..(count==1 and '' or 's')..' turned off') or 'Nothing was switched on')
    return count
end

-- LeftControl: hide / show the whole menu.
-- Shows the menu once the startup splash has gone.
function UI:Reveal()
    self.Revealed = true
    if not (self.Main and self.Main.Parent) or not self.PendingReveal then return end
    self.PendingReveal = false
    self.Main.Visible = true
    if self.Scale then
        local rest = self.Scale.Scale
        self.Scale.Scale = rest * 0.9
        self:Tween(self.Scale, { Scale = rest }, .3, Enum.EasingStyle.Back)
    end
    self:Toast('Kizzy Hub', 'Ready')
end

function UI:ToggleMenu()
    if not self.Main or self.PendingReveal then return end
    if self.Bubble then self.Bubble.Visible=false end
    self.Main.Visible=not self.Main.Visible
end

-- Optional: tuck the menu into the bubble when a round starts, bring it back when it ends.
-- Edge-triggered, so opening the menu yourself mid-round is respected.
function UI:AutoHideStep()
    if not self.Main or self.PendingReveal then return end
    local inRound = xDTaraZ.Match.InRound()
    if xDTaraZ.Options.AutoHideInRound then
        if inRound and not self.WasInRound and self.Main.Visible then
            self.Main.Visible = false
            if self.Bubble then self.Bubble.Visible = true end
            self.AutoHidden = true
        end
    else
        self.AutoHidden = false
    end
    if not inRound and self.WasInRound and self.AutoHidden then
        self.AutoHidden = false
        self.Main.Visible = true
        if self.Bubble then self.Bubble.Visible = false end
    end
    self.WasInRound = inRound
end

function UI:ResetWindow()
    if self.Main then self.Main.Position=UDim2.fromScale(.5,.5); self.Main.Visible=true end
    if self.Bubble then self.Bubble.Visible=false end
end

function UI:SafeBuild()
    local ok, err = pcall(self.Build, self)
    self.Building = false
    if not ok then warn("[Kizzy Hub] menu build error: " .. tostring(err)) end
    return ok
end

