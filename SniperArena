-- The risky internal hook is still installed lazily only when a real fallback shot needs it.
function xDTaraZ.Combat.DeepActive()
    local o = xDTaraZ.Options
    return o.Aimbot == true or o.SilentAim == true or o.Ragebot == true
end

function xDTaraZ.Combat.Active()
    local o = xDTaraZ.Options
    return o.Aimbot or o.SilentAim or o.Ragebot or o.TriggerBot or o.ShowFov
end

---@return BasePart?  resolve a requested aim bone from the visible rig or server collider
function xDTaraZ.Combat.ResolveBone(entity, bone, preferCollider)
    local char = xDTaraZ.Entity.Character(entity)
    if not char then return nil end

    bone = tostring(bone or xDTaraZ.Options.AimBone or "Head")
    if bone == "Head/Torso Weighted" then bone = "Head" end
    local collider = char:FindFirstChild("Collider")
    local aliases = {
        Head = { "Head" },
        Body = { "UpperTorso", "Torso", "Body", "LowerTorso", "HumanoidRootPart" },
        Arm = { "RightUpperArm", "RightArm", "RightLowerArm", "LeftUpperArm", "LeftLowerArm", "Arm" },
        Leg = { "RightUpperLeg", "RightLeg", "RightLowerLeg", "LeftUpperLeg", "LeftLowerLeg", "Leg" },
    }
    local names = aliases[bone] or { bone }

    local wanted = {}
    for _, name in ipairs(names) do wanted[name] = true end

    local function directPart(parent)
        if not parent then return nil end
        for _, name in ipairs(names) do
            local part = parent:FindFirstChild(name)
            if part and part:IsA("BasePart") then return part end
        end
        return nil
    end

    local function descendantPart(parent, excludedRoot)
        if not parent then return nil end
        for _, part in ipairs(parent:GetDescendants()) do
            if part:IsA("BasePart") and wanted[part.Name] then
                if not excludedRoot or not part:IsDescendantOf(excludedRoot) then
                    return part
                end
            end
        end
        return nil
    end

    if preferCollider then
        -- Silent/Rage/Fly shots may use the game's replicated collider first.
        local part = directPart(collider) or descendantPart(collider)
        if part then return part end

        -- Fall back to the visible rig if this game build has no matching collider.
        part = directPart(char) or descendantPart(char, collider)
        if part then return part end
    else
        -- CAMERA AIM: always prefer the real visible rig. Using a recursive search
        -- on the whole character could accidentally return Collider.Head, which in
        -- this game can be offset far below the visible head and make aim look like
        -- it is locking to the feet.
        local part = directPart(char) or descendantPart(char, collider)
        if part then return part end

        -- Collider is only a last-resort camera fallback.
        part = directPart(collider) or descendantPart(collider)
        if part then return part end
    end

    -- Never intentionally turn a requested head target into another body part.
    if bone == "Head" then return nil end
    return xDTaraZ.Entity.Root(entity)
end

-- Camera/target selection uses the visible avatar rig.
function xDTaraZ.Combat.BonePart(entity, bone)
    return xDTaraZ.Combat.ResolveBone(entity, bone, false)
end

-- Firing may prefer the game's replicated collider while preserving AimBone.
function xDTaraZ.Combat.HitPart(entity, bone)
    return xDTaraZ.Combat.ResolveBone(entity, bone, true)
end

function xDTaraZ.Combat.ShotBone()
    local bone = tostring(xDTaraZ.Options.AimBone or "Head")
    if bone ~= "Head/Torso Weighted" then return bone end
    local chance = Util.Number(xDTaraZ.Options.HeadChance, 70, 0, 100)
    return math.random(100) <= chance and "Head" or "Body"
end

---@return Vector3?  exact point the camera should visibly lock to
function xDTaraZ.Combat.CameraAimPosition(entity, part)
    if not (part and part.Parent) then return nil end

    -- Extra head-lock safety: when Head is selected, re-resolve from the visible
    -- rig so a server collider can never pull the camera down toward the feet.
    if (xDTaraZ.Options.AimBone == "Head" or xDTaraZ.Options.AimBone == "Head/Torso Weighted") and entity then
        local visibleHead = xDTaraZ.Combat.ResolveBone(entity, "Head", false)
        if visibleHead then part = visibleHead end
    end

    if xDTaraZ.Options.AimVisualPrediction then
        return xDTaraZ.Combat.Predict(part)
    end
    return part.Position
end

-- Called before every visibility ray. The filter only needs refreshing when the camera or our
-- character changes, so it is rebuilt at most every 20 ms (about one combat tick).
local filterState = { Cam = nil, Char = nil, At = -1 }
function xDTaraZ.Combat.Filter()
    local cam = Workspace.CurrentCamera
    local now = osClock()
    if cam and cam == filterState.Cam and now - filterState.At < 0.02 then return cam end
    local localChar = xDTaraZ.Entity.Character(xDTaraZ.Entity.Local())
    if cam ~= filterState.Cam or localChar ~= filterState.Char then
        local filter = { cam, localChar }
        aimParams.FilterDescendantsInstances = filter
        collisionAimParams.FilterDescendantsInstances = filter
        filterState.Cam, filterState.Char = cam, localChar
    end
    filterState.At = now
    return cam
end

---@return CFrame, any  where the game fires bullets from, detect tag
function xDTaraZ.Combat.Origin()
    local fn = xDTaraZ.Combat.OriginFn
    if not fn then
        local camCtrl = xDTaraZ.GameLib.CameraController
        local ok, resolved = pcall(function()
            return camCtrl and camCtrl.GetCombatOriginFn and camCtrl.GetCombatOriginFn()
        end)
        fn = ok and resolved or nil
        if type(fn) == "function" then xDTaraZ.Combat.OriginFn = fn end
    end
    if type(fn) == "function" then
        local ok, origin, detect = pcall(fn)
        if ok and typeof(origin) == "CFrame" then return origin, detect end
    end
    local cam = Workspace.CurrentCamera
    return cam and cam.CFrame or CFrame.new(), nil
end

-- Strict line-of-sight test. The normal query ray must actually reach the target,
-- and a second collision-respecting ray must not find collidable cover first.
-- This catches many map walls that the old single ray missed because CanQuery was off.
function xDTaraZ.Combat.StrictRayVisible(origin, part, char)
    if typeof(origin) ~= "Vector3" or not (part and part.Parent and char and char.Parent) then return false end
    local direction = part.Position - origin
    if direction.Magnitude <= 0.05 then return true end

    local queryHit = Workspace:Raycast(origin, direction, aimParams)
    if not (queryHit and queryHit.Instance and queryHit.Instance:IsDescendantOf(char)) then
        return false
    end

    local collisionHit = Workspace:Raycast(origin, direction, collisionAimParams)
    if collisionHit and collisionHit.Instance and not collisionHit.Instance:IsDescendantOf(char) then
        return false
    end
    return true
end

-- Camera visibility: used by normal Aimbot target selection.
function xDTaraZ.Combat.Visible(part, char)
    local cam = xDTaraZ.Combat.Filter()
    if not cam then return false end
    return xDTaraZ.Combat.StrictRayVisible(cam.CFrame.Position, part, char)
end

-- Shot visibility: used by Ragebot / Silent Aim / 360 so a clear camera angle
-- cannot redirect a shot through cover that blocks the game's firing origin.
function xDTaraZ.Combat.FireVisible(part, char)
    xDTaraZ.Combat.Filter()
    local origin = xDTaraZ.Combat.Origin()
    if typeof(origin) ~= "CFrame" then return false end
    return xDTaraZ.Combat.StrictRayVisible(origin.Position, part, char)
end

function xDTaraZ.Combat.IsEnemy(entity)
    if type(entity) ~= "table" or xDTaraZ.Entity.IsLocal(entity) then return false end
    if xDTaraZ.Options.AimTeamCheck and xDTaraZ.Entity.Friendly(entity) then return false end
    local inst = entity.Instance
    if typeof(inst) == "Instance" and inst:GetAttribute("State") == "Dead" then return false end
    return xDTaraZ.Entity.Health(entity) > 0
end

---@return table?, BasePart?  best target inside the FOV circle
---@return Vector2  screen point the FOV circle is centred on
function xDTaraZ.Combat.AimCenter(cam)
    local centerMode = xDTaraZ.Options.FovCenter or "Auto"
    if centerMode == "Mouse" then return UserInputService:GetMouseLocation() end
    if centerMode == "Screen Center" then return cam.ViewportSize / 2 end
    if xDTaraZ.Options.AimPriority == "Mouse" then return UserInputService:GetMouseLocation() end
    return cam.ViewportSize / 2
end

function xDTaraZ.Combat.UiColor(name, fallback)
    if name == "White" then return Color3.new(1,1,1) end
    if name == "Red" then return Color3.fromRGB(255,80,90) end
    if name == "Green" then return Color3.fromRGB(80,235,135) end
    if name == "Blue" then return Color3.fromRGB(80,180,255) end
    if name == "Purple" or name == "Accent" then return Color3.fromRGB(126,92,255) end
    return fallback or Color3.new(1,1,1)
end

function xDTaraZ.Combat.UsesFov()
    -- Camera Aimbot always keeps its own front-facing targeting rules. Rage
    -- settings are only used here when there is no camera Aimbot active.
    if xDTaraZ.Combat.AimActive() then
        local mode = xDTaraZ.Options.AimPriority
        return mode == "Crosshair" or mode == "Mouse"
    end
    if xDTaraZ.Options.Ragebot then return xDTaraZ.Options.RageUseFov == true end
    local mode = xDTaraZ.Options.AimPriority
    return mode == "Crosshair" or mode == "Mouse"
end

-- Ragebot on its own uses the Rage FOV / Rage distance; the camera Aimbot always uses its own.
function xDTaraZ.Combat.RageOnly()
    return xDTaraZ.Options.Ragebot == true and not xDTaraZ.Combat.AimActive()
end

function xDTaraZ.Combat.FovRadius()
    if xDTaraZ.Combat.RageOnly() then return Util.Number(xDTaraZ.Options.RageFov,600,20,2000) end
    return Util.Number(xDTaraZ.Options.AimFov,150,20,3000)
end

function xDTaraZ.Combat.MaxDistance()
    if xDTaraZ.Combat.RageOnly() then return Util.Number(xDTaraZ.Options.RageMaxDistance,1600,50,10000) end
    return Util.Number(xDTaraZ.Options.AimMaxDistance,1000,50,10000)
end

function xDTaraZ.Combat.NeedsVisibility()
    if xDTaraZ.Combat.AimActive() then return xDTaraZ.Options.AimWallCheck == true end
    if xDTaraZ.Options.Ragebot then return xDTaraZ.Options.RageWallCheck == true end
    return xDTaraZ.Options.AimWallCheck == true
end

function xDTaraZ.Combat.NeedsFireVisibility()
    if xDTaraZ.Options.Ragebot then return xDTaraZ.Options.RageWallCheck == true end
    return xDTaraZ.Options.AimWallCheck == true
end

function xDTaraZ.Combat.BindCamera()
    if xDTaraZ.Combat.Bound then return end
    xDTaraZ.Combat.Bound = true
    RunService:BindToRenderStep("xDTaraZAim", xDTaraZ.Config.AimRenderPriority, function()
        local c = xDTaraZ.Combat
        local cam = Workspace.CurrentCamera
        local part = c.Part
        if not (c.AimActive() and part and part.Parent) then
            xDTaraZ.Combat.Look = nil
            return
        end
        local origin = cam.CFrame.Position
        local aimPosition = xDTaraZ.Combat.CameraAimPosition(c.Target, part)
        if not aimPosition then
            xDTaraZ.Combat.Look = nil
            return
        end
        local want = (aimPosition - origin).Unit
        local smooth = math.max(xDTaraZ.Options.AimSmooth or 1, 1)
        local look = xDTaraZ.Combat.Look or cam.CFrame.LookVector
        look = smooth <= 1 and want or look:Lerp(want, 1 / smooth).Unit
        xDTaraZ.Combat.Look = look
        cam.CFrame = CFrame.lookAt(origin, origin + look)
    end)
end

function xDTaraZ.Combat.UnbindCamera()
    if not xDTaraZ.Combat.Bound then return end
    xDTaraZ.Combat.Bound = false
    RunService:UnbindFromRenderStep("xDTaraZAim")
end

---@return boolean  crosshair currently on an enemy hitbox
function xDTaraZ.Combat.CrosshairOnEnemy()
    xDTaraZ.Combat.Filter()
    local origin = xDTaraZ.Combat.Origin()
    local hit = Workspace:Raycast(origin.Position, origin.LookVector * xDTaraZ.Config.TriggerRange, aimParams)
    if not hit then return false end
    for _, entity in pairs(xDTaraZ.Entity.List()) do
        local char = xDTaraZ.Entity.Character(entity)
        if char and hit.Instance:IsDescendantOf(char) then return xDTaraZ.Combat.IsEnemy(entity) end
    end
    return false
end

---@return boolean  true when the weapon accepted the shot
function xDTaraZ.Combat.Fire()
    local now = os.clock()
    if now - xDTaraZ.Combat.LastShot < xDTaraZ.Config.FireInterval then return false end
    xDTaraZ.Combat.LastShot = now

    local _, shooter = xDTaraZ.Combat.Shooter()
    if not shooter then return false end

    xDTaraZ.Combat.InLocalFire = true
    local ok, fired = pcall(shooter.LocalShoot, shooter)
    xDTaraZ.Combat.InLocalFire = false
    local accepted = ok and fired ~= nil and fired ~= false
    if not ok then warn("[SniperArena] shoot:", fired) end
    return accepted
end

function xDTaraZ.Combat.Shooter()
    local combat = xDTaraZ.GameLib.Service.CombatService
    local weapon = combat and combat.GetCurrentWeapon()
    return weapon, weapon and weapon._Shootable
end

xDTaraZ.Combat.SilentSaved = {}
xDTaraZ.Combat.DeepSilent = {
    Installed = false,
    Attempted = false,
    Window = false,
    Status = "Not initialized",
    Module = nil,
    OriginFn = nil,
    TargetFn = nil,
}

function xDTaraZ.Combat.DeepTarget()
    local c = xDTaraZ.Combat
    if not (xDTaraZ.State.Alive and c.DeepActive() and c.DeepSilent.Window) then return nil end

    local entity
    if c.SilentActive() then
        entity = c.FireTarget or c.Target
    else
        entity = c.Target
    end

    if not entity then return nil end
    local part = c.HitPart(entity, c.DeepSilent.ForcedBone or c.ShotBone())
    if not (part and part.Parent) then return nil end
    local char = xDTaraZ.Entity.Character(entity)
    if c.NeedsFireVisibility() and not c.FireVisible(part, char) then return nil end
    return entity, part, c.Predict(part)
end

function xDTaraZ.Combat.ApplyDeepSilent()
    local c, ds = xDTaraZ.Combat, xDTaraZ.Combat.DeepSilent
    if ds.Installed then return true end
    local now = os.clock()
    if now < (ds.RetryAt or 0) then return false end
    ds.RetryAt = now + 2
    ds.Attempted = true

    if not (xDTaraZ.Caps.HookFunction and xDTaraZ.Caps.Upvalues and Util.HookFunction and Util.GetUpvalue) then
        ds.Status = "Executor missing hook/upvalue support"
        return false
    end

    local client = ReplicatedStorage:FindFirstChild("Client")
    local combatController = client and client:FindFirstChild("CombatController")
    local components = combatController and combatController:FindFirstChild("ClientComponent")
    local moduleScript = components and components:FindFirstChild("ClientShootableComponent")
    if not (moduleScript and moduleScript:IsA("ModuleScript")) then
        ds.Status = "ClientShootableComponent not found"
        return false
    end

    local okModule, module = pcall(require, moduleScript)
    if not okModule or type(module) ~= "table" or type(module.LocalShoot) ~= "function" then
        ds.Status = "ClientShootableComponent unavailable"
        return false
    end
    ds.Module = module

    local originFn, targetFn
    for index = 1, 20 do
        local ok, a, b = pcall(Util.GetUpvalue, module.LocalShoot, index)
        if ok then
            local candidate = type(b) == "function" and b or (type(a) == "function" and a or nil)
            if candidate then
                local called, r1, r2, r3 = pcall(candidate)
                if called then
                    if not originFn and typeof(r1) == "CFrame" and type(r3) == "table" then
                        originFn = candidate
                    elseif not targetFn and typeof(r1) == "Vector3" and typeof(r2) == "Instance" then
                        targetFn = candidate
                    end
                end
            end
        end
    end

    if not originFn and not targetFn then
        ds.Status = "Internal target functions not found"
        return false
    end

    if originFn then
        local originalOrigin
        local okHook, old = pcall(Util.HookFunction, originFn, function(...)
            local results = table.pack(originalOrigin(...))
            local _, _, position = c.DeepTarget()
            if position and typeof(results[1]) == "CFrame" then
                results[1] = CFrame.lookAt(results[1].Position, position)
            end
            return table.unpack(results, 1, results.n)
        end)
        if okHook and type(old) == "function" then
            originalOrigin = old
            ds.OriginFn, ds.OriginOriginal = originFn, old
        end
    end

    if targetFn then
        local originalTarget
        local okHook, old = pcall(Util.HookFunction, targetFn, function(...)
            local _, part, position = c.DeepTarget()
            if position and part then return position, part end
            return originalTarget(...)
        end)
        if okHook and type(old) == "function" then
            originalTarget = old
            ds.TargetFn, ds.TargetOriginal = targetFn, old
        end
    end

    ds.Installed = ds.OriginFn ~= nil or ds.TargetFn ~= nil
    ds.Status = ds.Installed and ((ds.OriginFn and ds.TargetFn) and "Origin + target hooks ready" or "Partial deep hook ready") or "Hook install failed"
    return ds.Installed
end

function xDTaraZ.Combat.DeepFallback(fallback, shooter, opts)
    local c, ds = xDTaraZ.Combat, xDTaraZ.Combat.DeepSilent
    if not (c.DeepActive() and type(fallback) == "function") then
        return fallback(shooter, opts)
    end

    -- Important stability change: do NOT probe/hook LocalShoot internals every frame.
    -- Only attempt the deep hook if a real redirected shot reaches this fallback path.
    if not ds.Installed and not c.ApplyDeepSilent() then
        return fallback(shooter, opts)
    end

    ds.ForcedBone = c.ShotBone()
    ds.Window = true
    local ok, result = pcall(fallback, shooter, opts)
    ds.Window = false
    ds.ForcedBone = nil
    if not ok then
        warn("[SniperArena] deep target fallback:", result)
        return nil
    end
    return result
end

function xDTaraZ.Combat.GetDeepHookStatus()
    local modes = {}
    if xDTaraZ.Options.Aimbot then modes[#modes + 1] = "Aimbot" end
    if xDTaraZ.Options.SilentAim then modes[#modes + 1] = "Silent" end
    if xDTaraZ.Options.Ragebot then modes[#modes + 1] = "Rage" end
    local suffix = #modes > 0 and (" · " .. table.concat(modes, "/")) or " · standby"
    return (xDTaraZ.Combat.DeepSilent.Status or "Always on") .. suffix
end

---@return table?  the game's combat-origin override table
function xDTaraZ.Combat.OriginOverride()
    local c = xDTaraZ.Combat
    if type(c.OriginParams) == "table" then return c.OriginParams end
    if not xDTaraZ.Caps.Upvalues then return nil end
    local now = os.clock()
    if now < (c.OriginRetryAt or 0) then return nil end
    c.OriginRetryAt = now + 1

    local camCtrl = xDTaraZ.GameLib.CameraController
    if not (camCtrl and type(camCtrl.GetCombatOriginFn) == "function") then return nil end
    local okFn, originFn = pcall(camCtrl.GetCombatOriginFn)
    if not okFn or type(originFn) ~= "function" then return nil end
    local ok, holder = pcall(function() return Util.GetUpvalue(originFn, 1) end)
    local params = ok and type(holder) == "table" and type(holder.TempParams) == "table" and holder.TempParams
    if params then c.OriginParams = params end
    return params
end

---@return any  what the game's Shoot returns
function xDTaraZ.Combat.ShootAt(shooter, entity, part, opts)
    local params = xDTaraZ.Combat.OriginOverride()
    if not (params and shooter and entity and part and part.Parent) then return nil end
    local start = xDTaraZ.Combat.Origin().Position
    local aim = xDTaraZ.Combat.Predict(part)
    opts = type(opts) == "table" and opts or {}
    opts.Target = entity.Instance
    opts.TargetHeadshot = part.Name == "Head" or nil
    local ok, localPos = pcall(function() return entity:GetPivot(true):PointToObjectSpace(aim) end)
    if ok then opts.TargetPos = localPos end

    local saved = { params.CameraCFrame, params.SubjectDistance, params.MouseLockOffset }
    params.CameraCFrame, params.SubjectDistance, params.MouseLockOffset = CFrame.lookAt(start, aim), 0, Vector3.zero
    local fired, shot = pcall(shooter.Shoot, shooter, start, (aim - start).Unit, opts)
    params.CameraCFrame, params.SubjectDistance, params.MouseLockOffset = saved[1], saved[2], saved[3]
    if not fired then warn("[SniperArena] silent:", shot) end
    return fired and shot or nil
end

---@return any  same as the game's LocalShoot, bullet sent at the locked target
function xDTaraZ.Combat.SilentShoot(shooter, opts)
    local c = xDTaraZ.Combat
    local saved = c.SilentSaved[shooter]
    local fallback = saved and saved.Fn
    if type(fallback) ~= "function" then return nil end

    local usingDeepAimbot = xDTaraZ.Options.Aimbot and not c.SilentActive()
    local entity = usingDeepAimbot and c.Target or (c.FireTarget or c.Target)
    if not ((c.SilentActive() or usingDeepAimbot) and entity) then return fallback(shooter, opts) end
    if math.random(100) > Util.Number(xDTaraZ.Options.HitChance, 100, 0, 100) then return fallback(shooter, opts) end

    local bone = c.ShotBone()
    local part = c.HitPart(entity, bone)
    if not (part and part.Parent) then return fallback(shooter, opts) end
    if c.NeedsFireVisibility() and not c.FireVisible(part, xDTaraZ.Entity.Character(entity)) then
        return fallback(shooter, opts)
    end

    -- Preferred path: preserve the existing explicit target/headshot metadata.
    if c.OriginOverride() then
        return c.ShootAt(shooter, entity, part, opts)
    end

    -- Fallback path borrowed from the alternate implementation: let LocalShoot
    -- run normally while its internal origin/target helpers are temporarily redirected.
    return c.DeepFallback(fallback, shooter, opts)
end

---@return CFrame  camera the server is told we look through
function xDTaraZ.Combat.ReportedLook(...)
    local c = xDTaraZ.Combat
    local cf = c.LookSource(...)
    local entity = c.FireTarget or c.Target
    local part = c.FirePart or c.Part
    if typeof(cf) ~= "CFrame" or not (c.SilentActive() and entity and part and part.Parent) then return cf end
    return CFrame.lookAt(cf.Position, c.Predict(part))
end

---@return table[]  tables that really hold CameraController's functions
function xDTaraZ.Combat.LookTables()
    local camCtrl = xDTaraZ.GameLib.CameraController
    local tables = {}
    if type(camCtrl) ~= "table" then return tables end
    if rawget(camCtrl, "GetCFrame") and not table.isfrozen(camCtrl) then tables[1] = camCtrl end
    local mt = Util.GetRawMetatable and Util.GetRawMetatable(camCtrl)
    local index = type(mt) == "table" and rawget(mt, "__index")
    if type(index) == "table" then index = { index } elseif type(index) == "function" and Util.GetUpvalues then index = Util.GetUpvalues(index) else index = {} end
    for _, holder in pairs(index) do
        if type(holder) == "table" and type(rawget(holder, "GetCFrame")) == "function" and not table.isfrozen(holder) then
            tables[#tables + 1] = holder
        end
    end
    return tables
end

function xDTaraZ.Combat.ApplyLook()
    local c = xDTaraZ.Combat
    if c.LookSource ~= nil then return end
    local tables = c.LookTables()
    if #tables == 0 then
        c.LookSource = false
        return
    end
    c.LookSource = rawget(tables[1], "GetCFrame")
    c.LookHolders = tables
    for _, holder in ipairs(tables) do pcall(rawset, holder, "GetCFrame", c.ReportedLook) end
end

function xDTaraZ.Combat.RestoreLook()
    local c = xDTaraZ.Combat
    if not c.LookSource then
        c.LookSource = nil
        return
    end
    for _, holder in ipairs(c.LookHolders or {}) do
        if rawget(holder, "GetCFrame") == c.ReportedLook then pcall(rawset, holder, "GetCFrame", c.LookSource) end
    end
    c.LookSource, c.LookHolders = nil, nil
end

function xDTaraZ.Combat.ApplySilent()
    local c = xDTaraZ.Combat
    local _, shooter = c.Shooter()
    if type(shooter) ~= "table" or type(shooter.Shoot) ~= "function" then return end

    if c.SilentShooter and c.SilentShooter ~= shooter then
        local old = c.SilentSaved[c.SilentShooter]
        if old then pcall(rawset, c.SilentShooter, "LocalShoot", old.Raw) end
        c.SilentSaved[c.SilentShooter] = nil
    end
    c.SilentShooter = shooter

    if rawget(shooter, "LocalShoot") == c.SilentShoot then return end
    local original = shooter.LocalShoot
    if type(original) ~= "function" then return end
    c.SilentSaved[shooter] = { Raw = rawget(shooter, "LocalShoot"), Fn = original }
    pcall(rawset, shooter, "LocalShoot", c.SilentShoot)
end

function xDTaraZ.Combat.RestoreSilent()
    local c = xDTaraZ.Combat
    for shooter, saved in pairs(c.SilentSaved) do
        pcall(rawset, shooter, "LocalShoot", saved.Raw)
    end
    table.clear(c.SilentSaved)
    c.SilentShooter = nil
end

xDTaraZ.Combat.ScopeSaved = {}

function xDTaraZ.Combat.ApplyInstantScope()
    local weapon = xDTaraZ.Combat.Shooter()
    local cfg = weapon and weapon.Config
    if type(cfg) ~= "table" or rawget(cfg, "AimTime") == 0 then return end
    if not xDTaraZ.Combat.ScopeSaved[cfg] then
        xDTaraZ.Combat.ScopeSaved[cfg] = { rawget(cfg, "AimTime"), rawget(cfg, "DelayTime") }
    end
    pcall(rawset, cfg, "AimTime", 0)
    pcall(rawset, cfg, "DelayTime", 0)
end

function xDTaraZ.Combat.RestoreScope()
    for cfg, saved in pairs(xDTaraZ.Combat.ScopeSaved) do
        pcall(rawset, cfg, "AimTime", saved[1])
        pcall(rawset, cfg, "DelayTime", saved[2])
    end
    table.clear(xDTaraZ.Combat.ScopeSaved)
end

function xDTaraZ.Combat.UpdateCircle()
    if not xDTaraZ.Caps.Drawing then return end
    local cam = Workspace.CurrentCamera
    if not cam then
        if xDTaraZ.Combat.Circle then xDTaraZ.Combat.Circle.Visible = false end
        if xDTaraZ.Combat.ImpactLine then xDTaraZ.Combat.ImpactLine.Visible = false end
        return
    end

    local circle = xDTaraZ.Combat.Circle
    local rageOnly = xDTaraZ.Options.Ragebot and not xDTaraZ.Combat.AimActive()
    local showCircle = xDTaraZ.Options.ShowFov and not (rageOnly and not xDTaraZ.Options.RageUseFov)

    if showCircle then
        if not circle then
            circle = Drawing.new("Circle")
            xDTaraZ.Combat.Circle = circle
        end
        circle.Position = xDTaraZ.Combat.AimCenter(cam)
        circle.Radius = rageOnly and xDTaraZ.Options.RageFov or xDTaraZ.Options.AimFov
        circle.Color = xDTaraZ.Combat.UiColor(xDTaraZ.Options.FovColor, Color3.new(1,1,1))
        circle.Transparency = math.clamp(Util.Number(xDTaraZ.Options.FovOpacity,70,5,100) / 100, 0.05, 1)
        circle.Thickness = Util.Number(xDTaraZ.Options.FovThickness,1,1,4)
        circle.NumSides = math.floor(Util.Number(xDTaraZ.Options.FovSides,64,16,128))
        circle.Filled = xDTaraZ.Options.FovFilled == true
        circle.Visible = true
    elseif circle then
        circle.Visible = false
    end

    local impact = xDTaraZ.Combat.ImpactLine
    if xDTaraZ.Options.CombatImpactLine then
        if not impact then
            impact = Drawing.new("Line")
            xDTaraZ.Combat.ImpactLine = impact
        end
        local part = xDTaraZ.Combat.FirePart or xDTaraZ.Combat.Part
        if part and part.Parent then
            local world = xDTaraZ.Combat.Predict(part)
            local screen, onScreen = cam:WorldToViewportPoint(world)
            if onScreen and screen.Z > 0 then
                impact.From = xDTaraZ.Combat.AimCenter(cam)
                impact.To = Vector2.new(screen.X, screen.Y)
                impact.Color = xDTaraZ.Combat.UiColor(xDTaraZ.Options.CombatImpactLineColor, Color3.fromRGB(255,80,90))
                impact.Thickness = Util.Number(xDTaraZ.Options.CombatImpactLineThickness,1,1,4)
                impact.Transparency = math.clamp(Util.Number(xDTaraZ.Options.CombatImpactLineOpacity,100,5,100) / 100, 0.05, 1)
                impact.Visible = true
            else
                impact.Visible = false
            end
        else
            impact.Visible = false
        end
    elseif impact then
        impact.Visible = false
    end
end

xDTaraZ.Combat.RecoilSaved = {}
xDTaraZ.Combat.ZoomSaved = {}

function xDTaraZ.Combat.ApplyNoRecoil()
    local combat = xDTaraZ.GameLib.Service.CombatService
    local weapon = combat and combat.GetCurrentWeapon()
    local cfg = weapon and weapon.Config
    if type(cfg) ~= "table" then return end
    if type(cfg.RecoilZoom) == "number" and cfg.RecoilZoom ~= 0 then
        xDTaraZ.Combat.ZoomSaved[cfg] = xDTaraZ.Combat.ZoomSaved[cfg] or cfg.RecoilZoom
        pcall(function() cfg.RecoilZoom = 0 end)
    end
    for _, key in ipairs({ "Recoil", "RecoilAiming" }) do
        local recoil = cfg[key]
        if type(recoil) == "table" and recoil.Degree ~= 0 then
            if xDTaraZ.Combat.RecoilSaved[recoil] == nil then xDTaraZ.Combat.RecoilSaved[recoil] = recoil.Degree end
            pcall(function() recoil.Degree = 0 end)
        end
    end
end

xDTaraZ.Combat.SpreadSaved = {}

function xDTaraZ.Combat.ZeroSpread()
    return 0
end

function xDTaraZ.Combat.ApplyNoSpread()
    local combat = xDTaraZ.GameLib.Service.CombatService
    local weapon = combat and combat.GetCurrentWeapon()
    local shooter = weapon and weapon._Shootable
    if type(shooter) ~= "table" or rawget(shooter, "GetCurrentSpread") == xDTaraZ.Combat.ZeroSpread then return end
    xDTaraZ.Combat.SpreadSaved[shooter] = { rawget(shooter, "GetCurrentSpread") }
    pcall(rawset, shooter, "GetCurrentSpread", xDTaraZ.Combat.ZeroSpread)
end

function xDTaraZ.Combat.RestoreSpread()
    for shooter, original in pairs(xDTaraZ.Combat.SpreadSaved) do
        pcall(rawset, shooter, "GetCurrentSpread", original[1])
    end
    table.clear(xDTaraZ.Combat.SpreadSaved)
end

function xDTaraZ.Combat.RestoreRecoil()
    for recoil, degree in pairs(xDTaraZ.Combat.RecoilSaved) do pcall(function() recoil.Degree = degree end) end
    for cfg, zoom in pairs(xDTaraZ.Combat.ZoomSaved) do pcall(function() cfg.RecoilZoom = zoom end) end
    table.clear(xDTaraZ.Combat.RecoilSaved)
    table.clear(xDTaraZ.Combat.ZoomSaved)
end

function xDTaraZ.Combat.Patches()
    local o, c = xDTaraZ.Options, xDTaraZ.Combat
    if o.NoRecoil then
        c.ApplyNoRecoil()
    elseif next(c.RecoilSaved) or next(c.ZoomSaved) then
        c.RestoreRecoil()
    end
    if o.NoSpread then c.ApplyNoSpread() elseif next(c.SpreadSaved) then c.RestoreSpread() end
    if o.InstantScope or o.Ragebot then c.ApplyInstantScope() elseif next(c.ScopeSaved) then c.RestoreScope() end
    local deepAimbot = o.Aimbot and not c.SilentActive()

    if c.SilentActive() or deepAimbot then
        c.ApplySilent()
    elseif next(c.SilentSaved) then
        c.RestoreSilent()
    end

    -- Camera spoofing is only needed for Silent/Rage. Normal Aimbot already moves
    -- the real camera, so Deep Target does not need to hook camera look for Aimbot.
    if c.SilentActive() then
        c.ApplyLook()
    else
        c.RestoreLook()
    end
end

function xDTaraZ.Combat.Step()
    local c = xDTaraZ.Combat
    c.UpdateCircle()
    c.Patches()
    if not c.Active() then
        if c.State ~= "Idle" then c.Stop() end
        return
    end
    if not xDTaraZ.Match.InRound() then
        c.Target, c.Part = nil, nil
        c.FireTarget, c.FirePart = nil, nil
        c.State, c.Status = "Wait", "Waiting for round"
        return
    end

    local mode = xDTaraZ.Match.Info() or "?"
    if c.AimActive() then c.BindCamera() else c.UnbindCamera() end
    if c.AimActive() or c.SilentActive() then
        local now = os.clock()
        local switchDelay = math.max(0, tonumber(xDTaraZ.Options.TargetSwitchDelay) or 0) / 1000
        local previous = c.Target
        local previousAlive = previous and xDTaraZ.Combat.IsEnemy(previous)
        local target, part

        if previous and not previousAlive and switchDelay > 0 then
            if c.LostTarget ~= previous then
                c.LostTarget = previous
                c.NextSwitchAt = now + switchDelay
            end
            if now < (c.NextSwitchAt or 0) then
                target, part = nil, nil
            else
                target, part = c.SelectTarget()
                c.LostTarget = nil
            end
        else
            target, part = c.SelectTarget()
            if previousAlive and target ~= previous and now < (c.NextSwitchAt or 0) then
                target = previous
                part = xDTaraZ.Combat.BonePart(previous)
            elseif target ~= previous then
                c.NextSwitchAt = now + switchDelay
                c.LostTarget = nil
            end
        end

        if target ~= previous then c.LockedSince = now end
        c.Target, c.Part = target, part
        c.State = target and "Locked" or "Acquire"
        local char = target and xDTaraZ.Entity.Character(target)
        c.Status = mode .. " · " .. (char and char.Name or "no target")
    else
        c.Target, c.Part = nil, nil
        c.FireTarget, c.FirePart = nil, nil
        c.State, c.Status = "Ready", mode .. " · aim idle"
    end

    -- Silent/Rage can keep a separate 360-degree firing target so the camera
    -- Aimbot remains front/FOV based while shots can still reach targets behind.
    local previousFire = c.FireTarget
    local fireTarget, firePart = c.Target, c.Part
    if c.SilentActive() and xDTaraZ.Options.Combat360 then
        fireTarget, firePart = c.SelectFireTarget360()
    end
    if fireTarget ~= previousFire then c.FireLockedSince = os.clock() end
    c.FireTarget, c.FirePart = fireTarget, firePart

    local displayTarget = (xDTaraZ.Options.Ragebot and c.FireTarget) or c.Target or c.FireTarget
    if displayTarget then
        local char = xDTaraZ.Entity.Character(displayTarget)
        c.State = "Locked"
        c.Status = mode .. " · " .. (char and char.Name or "target") .. (xDTaraZ.Options.Combat360 and c.SilentActive() and " · 360" or "")
    end

    -- Ragebot reaction delay is separate from camera/lock settling.
    -- Default 0 ms = fire on the first combat tick after a valid target is acquired.
    local rageReaction = math.max(0, tonumber(xDTaraZ.Options.RageReactionDelay) or 0) / 1000
    local settled = c.FireTarget ~= nil and os.clock() - (c.FireLockedSince or 0) >= rageReaction
    local rageVisible = true
    if xDTaraZ.Options.Ragebot and settled and c.NeedsFireVisibility() then
        local checkPart = c.FirePart or c.Part
        local fireChar = c.FireTarget and xDTaraZ.Entity.Character(c.FireTarget)
        rageVisible = checkPart ~= nil and fireChar ~= nil and c.FireVisible(checkPart, fireChar)
    end
    local shoot = (xDTaraZ.Options.Ragebot and settled and rageVisible)
        or (xDTaraZ.Options.TriggerBot and c.CrosshairOnEnemy())
    if shoot and c.Fire() then c.State = "Fired" end
end

function xDTaraZ.Combat.Stop()
    xDTaraZ.Combat.UnbindCamera()
    xDTaraZ.Combat.Target, xDTaraZ.Combat.Part = nil, nil
    xDTaraZ.Combat.FireTarget, xDTaraZ.Combat.FirePart = nil, nil
    xDTaraZ.Combat.State, xDTaraZ.Combat.Status = "Idle", "Off"
    if xDTaraZ.Combat.Circle then xDTaraZ.Combat.Circle.Visible = false end
end

function xDTaraZ.Combat.Unload()
    xDTaraZ.Combat.Stop()
    xDTaraZ.Combat.RestoreRecoil()
    xDTaraZ.Combat.RestoreSpread()
    xDTaraZ.Combat.RestoreScope()
    xDTaraZ.Combat.RestoreSilent()
    xDTaraZ.Combat.RestoreLook()
    if xDTaraZ.Combat.Circle then
        xDTaraZ.Combat.Circle:Remove()
        xDTaraZ.Combat.Circle = nil
    end
    if xDTaraZ.Combat.ImpactLine then
        xDTaraZ.Combat.ImpactLine:Remove()
        xDTaraZ.Combat.ImpactLine = nil
    end
end

function xDTaraZ.Combat.GetStatus()
    return xDTaraZ.Combat.Status
end

