---@return string?  skin rarity from WrapConfig, nil for base/unknown skins
function xDTaraZ.Sell.RarityOf(weaponName)
    local skin = tostring(weaponName):match("%.(.+)$")
    local wraps = GameLib.Config.WrapConfig
    local entry = skin and type(wraps) == "table" and wraps[skin]
    return type(entry) == "table" and entry.Rarity or nil
end

local SELL_RANK = { Common = 1, UnCommon = 2, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mystic = 6, Mythic = 6 }

---@return string[]  rarity names present in WrapConfig, lowest rarity first
function xDTaraZ.Sell.Rarities()
    local wraps = GameLib.Config.WrapConfig
    if type(wraps) ~= "table" then return {} end
    local seen = {}
    for _, entry in pairs(wraps) do
        if type(entry) == "table" and entry.Rarity then seen[tostring(entry.Rarity)] = true end
    end
    local names = Util.SortedKeys(seen)
    table.sort(names, function(a, b)
        local ra, rb = SELL_RANK[a] or 99, SELL_RANK[b] or 99
        if ra ~= rb then return ra < rb end
        return a < b
    end)
    return names
end

---@return table[]  owned weapons with uid, rarity, price, wear
function xDTaraZ.Sell.Inventory()
    local service = GameLib.Service.WeaponService
    local ok, content = pcall(function() return service and service.GetContent() end)
    if not ok or type(content) ~= "table" then return {} end

    local list = {}
    for uid, weapon in pairs(content) do
        if type(weapon) == "table" then
            list[#list + 1] = {
                Uid = uid,
                Name = weapon.Name or tostring(uid),
                Rarity = xDTaraZ.Sell.RarityOf(weapon.Name),
                Price = tonumber(weapon.Price) or 0,
                Wear = tonumber(weapon.WearFactor) or 0,
            }
        end
    end
    return list
end

---@return string[], number  uids to sell (matching rarities under the price cap), and their total price
function xDTaraZ.Sell.Pick()
    local wanted = Util.SetFromList(xDTaraZ.Options.SellRarities)
    local ceiling = Util.Number(xDTaraZ.Options.MaxSellPrice, 0)
    local keepEach = math.max(0, math.floor(Util.Number(xDTaraZ.Options.KeepPerRarity, 0)))
    local inventory = xDTaraZ.Sell.Inventory()
    -- Most valuable first, so "Keep Per Rarity" keeps the BEST items. The inventory comes from
    -- pairs(), whose order is arbitrary, so it used to keep (and sell) random ones.
    table.sort(inventory, function(a, b)
        if a.Price ~= b.Price then return a.Price > b.Price end
        if a.Wear ~= b.Wear then return a.Wear < b.Wear end
        return tostring(a.Uid) < tostring(b.Uid)
    end)

    local kept, uids, total = {}, {}, 0
    for _, weapon in ipairs(inventory) do
        if weapon.Rarity and wanted[weapon.Rarity] and (ceiling <= 0 or weapon.Price <= ceiling) then
            kept[weapon.Rarity] = (kept[weapon.Rarity] or 0) + 1
            if kept[weapon.Rarity] > keepEach then
                uids[#uids + 1] = weapon.Uid
                total += weapon.Price
            end
        end
    end
    return uids, total
end

---@return boolean  true when at least one sell rarity is ticked
function xDTaraZ.Sell.HasFilter()
    return next(Util.SetFromList(xDTaraZ.Options.SellRarities)) ~= nil
end

---@return string  what a sell would do right now, without selling anything
function xDTaraZ.Sell.Preview()
    if not xDTaraZ.Sell.HasFilter() then return "Tick at least one rarity first" end
    local uids, total = xDTaraZ.Sell.Pick()
    if #uids == 0 then return "Nothing matches your filters" end
    return string.format("Would sell %d item%s for %s", #uids, #uids == 1 and "" or "s", Util.FormatNumber(total))
end

function xDTaraZ.Sell.SellNow()
    local service = GameLib.Service.WeaponService
    if not service then xDTaraZ.Sell.LastResult = "no service" return xDTaraZ.Sell.LastResult end
    if not xDTaraZ.Sell.HasFilter() then
        xDTaraZ.Sell.LastResult = "pick sell rarities first"
        return xDTaraZ.Sell.LastResult
    end

    local uids = xDTaraZ.Sell.Pick()
    if #uids == 0 then
        xDTaraZ.Sell.LastResult = "nothing to sell"
        return xDTaraZ.Sell.LastResult
    end

    local ok, response = pcall(function() return service.Sell(uids) end)
    xDTaraZ.Sell.LastResult = ok and (#uids .. " sold") or ("sell failed: " .. tostring(response))
    return xDTaraZ.Sell.LastResult
end

