xDTaraZ.Build = {
    Name = "Kizzy Sniper Arena",
    Version = "6.2.0",
    Date = "2026-10-07",
}

-- Track when replicated combatants first appear so newly-spawned players can be ignored briefly.
xDTaraZ.Combat.SeenAt = setmetatable({}, { __mode = "k" })
function xDTaraZ.Combat.SpawnReady(entity)
    local now = os.clock()
    local seen = xDTaraZ.Combat.SeenAt[entity]
    if not seen then xDTaraZ.Combat.SeenAt[entity] = now; seen = now end
    local grace = math.max(0, tonumber(xDTaraZ.Options.SpawnGrace) or 0) / 1000
    return now - seen >= grace
end

-- Adaptive prediction keeps the visible aim steady while making the actual shot lead scale with speed/distance/weapon.
function xDTaraZ.Combat.ProjectileSpeed()
    local weapon = select(1, xDTaraZ.Combat.Shooter())
    local cfg = weapon and weapon.Config
    if type(cfg) ~= "table" then return nil end
    for _, key in ipairs({ "ProjectileSpeed", "BulletSpeed", "MuzzleVelocity", "Velocity" }) do
        local v = tonumber(rawget(cfg, key) or cfg[key])
        if v and v > 50 then return v end
    end
    return nil
end

function xDTaraZ.Combat.Predict(part)
    if not part then return Vector3.zero end
    local base = math.max(0, tonumber(xDTaraZ.Options.AimPrediction) or 0) / 1000
    local strength = math.clamp(tonumber(xDTaraZ.Options.PredictionStrength) or 100, 0, 200) / 100
    local lead = base * strength
    local velocity = part.AssemblyLinearVelocity
    if xDTaraZ.Options.AdaptivePrediction then
        local origin = xDTaraZ.Combat.Origin().Position
        local distance = (part.Position - origin).Magnitude
        local speed = velocity.Magnitude
        local projectile = xDTaraZ.Combat.ProjectileSpeed()
        if projectile then lead = math.max(lead, distance / projectile) end
        lead += math.clamp(distance / 6000, 0, .12) * math.clamp(speed / 70, .25, 1.5)
        lead = math.clamp(lead, 0, .45)
    end
    local predicted = part.Position + velocity * lead
    if xDTaraZ.Options.AirPrediction and math.abs(velocity.Y) > 4 and lead > 0 then
        predicted += Vector3.new(0, -0.5 * Workspace.Gravity * lead * lead * 0.12, 0)
    end
    return predicted
end

function xDTaraZ.Combat.ThreatScore(entity, part, origin)
    local root = xDTaraZ.Entity.Root(entity)
    local distance = (part.Position - origin).Magnitude
    local health, maxHealth = xDTaraZ.Entity.Health(entity)
    local hp = maxHealth > 0 and health / maxHealth or 1
    local facing = 0
    if root then
        local towardMe = origin - root.Position
        if towardMe.Magnitude > .01 then facing = math.clamp(root.CFrame.LookVector:Dot(towardMe.Unit), -1, 1) end
    end
    return distance * 0.72 + hp * 65 - facing * 45
end

function xDTaraZ.Combat.AdvancedScore(entity, part, cam, center, origin)
    local distance = (part.Position - origin).Magnitude
    local priority = xDTaraZ.Options.AdvancedTargetPriority or "Smart"
    local health = select(1, xDTaraZ.Entity.Health(entity))
    local screen, onScreen = Vector3.zero, false
    if cam then screen, onScreen = cam:WorldToViewportPoint(part.Position) end
    local gap = onScreen and (Vector2.new(screen.X, screen.Y) - center).Magnitude or 100000
    local score
    if priority == "Crosshair" then score = gap
    elseif priority == "Closest" then score = distance
    elseif priority == "Lowest Health" then score = health * 100 + distance * .05
    elseif priority == "Highest Threat" then score = xDTaraZ.Combat.ThreatScore(entity, part, origin)
    elseif priority == "Furthest" then score = -distance
    elseif priority == "Weighted" then score = distance * .55 + health * 5 + math.min(gap, 1500) * .18
    else
        -- Smart: distance + health + threat + modest crosshair preference when visible.
        score = xDTaraZ.Combat.ThreatScore(entity, part, origin) * .65 + health * 1.5 + distance * .25
        if onScreen then score -= math.max(0, 45 - gap * .03) end
    end
    return score
end

xDTaraZ.Combat.LookBackCache = { At = 0, Entity = nil, Part = nil }

function xDTaraZ.Combat.SelectLookBackTarget(cam, origin)
    if not (xDTaraZ.Options.Aimbot and xDTaraZ.Options.AimLookBack and cam) then return nil end

    local cache = xDTaraZ.Combat.LookBackCache
    local now = os.clock()

    -- Re-use a recently found target briefly so the whole-world fallback scan
    -- does not run at the full combat-loop rate.
    if now - (cache.At or 0) < 0.05 then
        local entity, part = cache.Entity, cache.Part
        if entity and part and part.Parent and xDTaraZ.Combat.IsEnemy(entity) then
            local char = xDTaraZ.Entity.Character(entity)
            local maxDistance = Util.Number(xDTaraZ.Options.AimMaxDistance,1000,50,10000)
            if (part.Position - origin).Magnitude <= maxDistance and xDTaraZ.Combat.Visible(part, char) then
                return entity, part
            end
        end
    end

    cache.At, cache.Entity, cache.Part = now, nil, nil

    local look = cam.CFrame.LookVector
    local maxDistance = Util.Number(xDTaraZ.Options.AimMaxDistance,1000,50,10000)
    local best, bestPart, bestScore

    for _, entity in pairs(xDTaraZ.Entity.All()) do
        if not xDTaraZ.Combat.IsEnemy(entity) or not xDTaraZ.Combat.SpawnReady(entity) then continue end

        local part = xDTaraZ.Combat.BonePart(entity)
        if not part then continue end

        local delta = part.Position - origin
        local distance = delta.Magnitude
        if distance <= 0.05 or distance > maxDistance then continue end

        local char = xDTaraZ.Entity.Character(entity)
        -- Look-back targets are intentionally visibility-only even if the normal
        -- Aimbot wall-check toggle is off.
        if not xDTaraZ.Combat.Visible(part, char) then continue end

        local dot = math.clamp(look:Dot(delta.Unit), -1, 1)
        local turnAngle = math.acos(dot)

        -- Prefer the smallest camera turn first, then the closer visible target.
        local score = turnAngle * 1000 + distance * 0.10
        if not bestScore or score < bestScore then
            best, bestPart, bestScore = entity, part, score
        end
    end

    cache.Entity, cache.Part = best, bestPart
    return best, bestPart
end

-- Replace camera selection with the same filters plus advanced priority/lock rules.
function xDTaraZ.Combat.SelectTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center, origin = xDTaraZ.Combat.AimCenter(cam), cam.CFrame.Position
    local current = xDTaraZ.Combat.Target
    local minLock = math.max(0, tonumber(xDTaraZ.Options.MinLockTime) or 0) / 1000
    if current and xDTaraZ.Combat.IsEnemy(current) then
        local keepForLock = os.clock() - (xDTaraZ.Combat.LockedSince or 0) < minLock
        local keepForShot = xDTaraZ.Options.NoSwitchWhileFiring and os.clock() - xDTaraZ.Combat.LastShot < .18
        if keepForLock or keepForShot or xDTaraZ.Options.TargetSticky then
            local p = xDTaraZ.Combat.BonePart(current)
            if p then
                local maxDistance = xDTaraZ.Combat.MaxDistance()
                local valid = (p.Position-origin).Magnitude <= maxDistance
                if valid and xDTaraZ.Combat.UsesFov() then
                    local sp, on = cam:WorldToViewportPoint(p.Position)
                    local lockScale = Util.Number(xDTaraZ.Options.TargetLockFovScale,135,100,250) / 100
                    local lockRadius = xDTaraZ.Combat.FovRadius() * lockScale
                    valid = on and (Vector2.new(sp.X,sp.Y)-center).Magnitude <= lockRadius
                end
                if valid and xDTaraZ.Combat.NeedsVisibility() then valid = xDTaraZ.Combat.Visible(p,xDTaraZ.Entity.Character(current)) end
                if valid then return current,p end
            end
        end
    end
    local best,bestPart,bestScore
    for _,entity in pairs(xDTaraZ.Entity.List()) do
        if not xDTaraZ.Combat.IsEnemy(entity) or not xDTaraZ.Combat.SpawnReady(entity) then continue end
        local part=xDTaraZ.Combat.BonePart(entity); if not part then continue end
        local dist=(part.Position-origin).Magnitude
        if dist>xDTaraZ.Combat.MaxDistance() then continue end
        if xDTaraZ.Combat.UsesFov() then
            local sp,on=cam:WorldToViewportPoint(part.Position); if not on then continue end
            if (Vector2.new(sp.X,sp.Y)-center).Magnitude>xDTaraZ.Combat.FovRadius() then continue end
        end
        if xDTaraZ.Combat.NeedsVisibility() and not xDTaraZ.Combat.Visible(part,xDTaraZ.Entity.Character(entity)) then continue end
        local score=xDTaraZ.Combat.AdvancedScore(entity,part,cam,center,origin)
        if not bestScore or score<bestScore then best,bestPart,bestScore=entity,part,score end
    end

    if best then return best,bestPart end

    -- If no normal front/FOV target is available, Aimbot can turn around toward
    -- the nearest clear visible enemy behind or beside the camera.
    if xDTaraZ.Options.Aimbot and xDTaraZ.Options.AimLookBack then
        return xDTaraZ.Combat.SelectLookBackTarget(cam, origin)
    end

    return nil
end

function xDTaraZ.Combat.SelectFireTarget360()
    local cam=Workspace.CurrentCamera
    local myRoot=xDTaraZ.Player.Root
    local origin=myRoot and myRoot.Position or (cam and cam.CFrame.Position)
    if not origin then return nil end
    local center=cam and xDTaraZ.Combat.AimCenter(cam) or Vector2.zero
    local maxDistance=xDTaraZ.Options.Ragebot and Util.Number(xDTaraZ.Options.RageMaxDistance,1600,50,10000) or Util.Number(xDTaraZ.Options.AimMaxDistance,1000,50,10000)
    -- Ragebot with "Use Rage FOV" only shoots enemies on screen inside the Rage FOV circle.
    local useRageFov=xDTaraZ.Options.Ragebot==true and xDTaraZ.Options.RageUseFov==true and cam~=nil
    local rageRadius=Util.Number(xDTaraZ.Options.RageFov,600,20,2000)
    local lockScale=Util.Number(xDTaraZ.Options.TargetLockFovScale,135,100,250)/100
    local function insideRageFov(part,scale)
        if not useRageFov then return true end
        local sp,on=cam:WorldToViewportPoint(part.Position)
        return on and (Vector2.new(sp.X,sp.Y)-center).Magnitude<=rageRadius*(scale or 1)
    end
    local current=xDTaraZ.Combat.FireTarget
    local minLock=math.max(0,tonumber(xDTaraZ.Options.MinLockTime) or 0)/1000
    if current and xDTaraZ.Combat.IsEnemy(current) then
        local keep=os.clock()-(xDTaraZ.Combat.FireLockedSince or 0)<minLock or xDTaraZ.Options.TargetSticky or (xDTaraZ.Options.NoSwitchWhileFiring and os.clock()-xDTaraZ.Combat.LastShot<.18)
        if keep then
            local p=xDTaraZ.Combat.BonePart(current)
            if p and (p.Position-origin).Magnitude<=maxDistance and insideRageFov(p,lockScale) then
                if not xDTaraZ.Combat.NeedsFireVisibility() or xDTaraZ.Combat.FireVisible(p,xDTaraZ.Entity.Character(current)) then return current,p end
            end
        end
    end
    local best,bestPart,bestScore
    for _,entity in pairs(xDTaraZ.Entity.All()) do
        if not xDTaraZ.Combat.IsEnemy(entity) or not xDTaraZ.Combat.SpawnReady(entity) then continue end
        local part=xDTaraZ.Combat.BonePart(entity); if not part then continue end
        if (part.Position-origin).Magnitude>maxDistance then continue end
        if not insideRageFov(part,1) then continue end
        if xDTaraZ.Combat.NeedsFireVisibility() and not xDTaraZ.Combat.FireVisible(part,xDTaraZ.Entity.Character(entity)) then continue end
        local score=xDTaraZ.Combat.AdvancedScore(entity,part,cam,center,origin)
        if not bestScore or score<bestScore then best,bestPart,bestScore=entity,part,score end
    end
    return best,bestPart
end

xDTaraZ.AutoSave = { Dirty=false, At=0, Last="Idle" }
function xDTaraZ.AutoSave.Queue()
    if not xDTaraZ.Options.AutoSave then return end
    local delay = Util.Number(xDTaraZ.Options.AutoSaveDelay, 1.25, 0.25, 10)
    xDTaraZ.AutoSave.Dirty=true; xDTaraZ.AutoSave.At=os.clock()+delay
end
function xDTaraZ.AutoSave.Step()
    if not (xDTaraZ.Options.AutoSave and xDTaraZ.AutoSave.Dirty and os.clock()>=xDTaraZ.AutoSave.At) then return end
    xDTaraZ.AutoSave.Dirty=false
    if xDTaraZ.ConfigStore and xDTaraZ.ConfigStore.Save then local ok,msg=xDTaraZ.ConfigStore.Save(); xDTaraZ.AutoSave.Last=ok and "Saved" or msg end
end
function xDTaraZ.AutoSave.GetStatus() return xDTaraZ.AutoSave.Last end

xDTaraZ.Protections = { Status="Ready" }
function xDTaraZ.Protections.Step()
    if not xDTaraZ.Options.AutoDisableProtection then xDTaraZ.Protections.Status="Disabled"; return end
    if not xDTaraZ.Player:IsAlive() then xDTaraZ.Protections.Status="Suspended: dead"; return end
    if not xDTaraZ.Match.InRound() then xDTaraZ.Protections.Status="Suspended: lobby/loading"; return end
    if not xDTaraZ.Combat.Shooter() then xDTaraZ.Protections.Status="Suspended: no weapon"; return end
    xDTaraZ.Protections.Status="Ready"
end
function xDTaraZ.Protections.GetStatus() return xDTaraZ.Protections.Status end

-- Protection suspends the combat loop without changing the user's toggles, so settings resume automatically next round.
do
    local protectedCombatStep=xDTaraZ.Combat.Step
    function xDTaraZ.Combat.Step()
        if xDTaraZ.Options.AutoDisableProtection then
            local weapon,shooter=xDTaraZ.Combat.Shooter()
            if not xDTaraZ.Player:IsAlive() or not xDTaraZ.Match.InRound() or not weapon or not shooter then
                xDTaraZ.Combat.UnbindCamera()
                xDTaraZ.Combat.Target,xDTaraZ.Combat.Part=nil,nil
                xDTaraZ.Combat.FireTarget,xDTaraZ.Combat.FirePart=nil,nil
                xDTaraZ.Combat.State="Protected"
                xDTaraZ.Combat.Status=not xDTaraZ.Player:IsAlive() and "Protected · dead" or (not xDTaraZ.Match.InRound() and "Protected · lobby/loading" or "Protected · no weapon")
                return
            end
        end
        return protectedCombatStep()
    end
end


-- Lean persistent config profiles. Stores only current options.
xDTaraZ.ConfigStore = {
    Folder = xDTaraZ.Config.SaveFolder,
    Last = "Not loaded",
    StartupDone = false,
    LastSavedAt = nil,
}

local function TrimText(value)
    return tostring(value or ""):match("^%s*(.-)%s*$") or ""
end

-- Profiles are free-form now. "Default" always exists; everything else is yours.
local DEFAULT_PROFILE = "Default"
local LEGACY_PROFILES = { "PvP", "Rage", "Farm" }    -- the old built-in presets: only kept if you already saved data under them

xDTaraZ.ConfigStore.Index = { Names = { DEFAULT_PROFILE }, Deleted = {}, FilesAt = -1000, FilesCache = {} }

local function SameName(a, b) return string.lower(tostring(a)) == string.lower(tostring(b)) end

---@return string?  letters, digits, - and _ only (spaces become _), at most 24 chars
function xDTaraZ.ConfigStore.SanitizeProfile(name)
    name = TrimText(name):gsub("%s+", "_"):gsub("[^%w_%-]", "")
    name = name:sub(1, 24)
    if name == "" then return nil end
    return name
end

function xDTaraZ.ConfigStore.InvalidateFiles()
    xDTaraZ.ConfigStore.Index.FilesAt = -1000
end

---@return string[]  profile names found on disk (needs listfiles; cached for a few seconds)
function xDTaraZ.ConfigStore.Files()
    local index = xDTaraZ.ConfigStore.Index
    if not Util.ListFiles then return {} end
    if osClock() - index.FilesAt < 4 then return index.FilesCache end
    local found = {}
    local ok, paths = pcall(Util.ListFiles, Util.MakeFolder and xDTaraZ.ConfigStore.Folder or ".")
    if ok and type(paths) == "table" then
        for _, path in ipairs(paths) do
            local name = tostring(path):match("config_([^/\\]+)%.json$")
            if name and xDTaraZ.ConfigStore.SanitizeProfile(name) == name then found[#found + 1] = name end
        end
    end
    index.FilesAt, index.FilesCache = osClock(), found
    return found
end

---@return string?  the profile's real name when it exists (Default always does)
function xDTaraZ.ConfigStore.Known(name)
    local clean = name ~= nil and xDTaraZ.ConfigStore.SanitizeProfile(name) or nil
    if not clean then return nil end
    if SameName(clean, DEFAULT_PROFILE) then return DEFAULT_PROFILE end
    local index = xDTaraZ.ConfigStore.Index
    if index.Deleted[string.lower(clean)] then return nil end
    for _, existing in ipairs(index.Names) do
        if SameName(existing, clean) then return existing end
    end
    for _, fileName in ipairs(xDTaraZ.ConfigStore.Files()) do
        if SameName(fileName, clean) then return fileName end
    end
    return nil
end

---@return string[]  Default first, then your profiles A-Z
function xDTaraZ.ConfigStore.List()
    local index = xDTaraZ.ConfigStore.Index
    local seen, extras = { default = true }, {}      -- keys are lower-case names
    local function add(name)
        local key = string.lower(name)
        if not seen[key] and not index.Deleted[key] then
            seen[key] = true
            extras[#extras + 1] = name
        end
    end
    for _, name in ipairs(index.Names) do add(name) end
    for _, name in ipairs(xDTaraZ.ConfigStore.Files()) do add(name) end
    table.sort(extras, function(a, b) return string.lower(a) < string.lower(b) end)
    table.insert(extras, 1, DEFAULT_PROFILE)
    return extras
end

function xDTaraZ.ConfigStore.ActiveProfile()
    return xDTaraZ.ConfigStore.Known(xDTaraZ.Options.ConfigProfile) or DEFAULT_PROFILE
end

function xDTaraZ.ConfigStore.SetSelectedProfile(profile)
    local known = xDTaraZ.ConfigStore.Known(profile) or DEFAULT_PROFILE
    xDTaraZ.Options.ConfigProfile = known
    return known
end

-- Some executors cannot create or write into folders. When that happens the config falls back to
-- plain files in the workspace root (UseFlat), and Save/Load/Meta all follow the same choice.
function xDTaraZ.ConfigStore.FlatPath(profile)
    local safe = xDTaraZ.ConfigStore.SanitizeProfile(profile or xDTaraZ.ConfigStore.ActiveProfile()) or DEFAULT_PROFILE
    return "KizzySniper_config_" .. safe .. ".json"
end

function xDTaraZ.ConfigStore.Path(profile)
    local safe = xDTaraZ.ConfigStore.SanitizeProfile(profile or xDTaraZ.ConfigStore.ActiveProfile()) or DEFAULT_PROFILE
    if Util.MakeFolder and not xDTaraZ.ConfigStore.UseFlat then return xDTaraZ.ConfigStore.Folder .. "/config_" .. safe .. ".json" end
    return xDTaraZ.ConfigStore.FlatPath(safe)
end

function xDTaraZ.ConfigStore.MetaPath()
    if Util.MakeFolder and not xDTaraZ.ConfigStore.UseFlat then return xDTaraZ.ConfigStore.Folder .. "/last_profile.json" end
    return "KizzySniper_last_profile.json"
end

function xDTaraZ.ConfigStore.EnsureFolder()
    if not xDTaraZ.Caps.FileSystem then return false end
    if Util.MakeFolder then
        local exists = false
        if Util.IsFolder then
            local ok, value = pcall(Util.IsFolder, xDTaraZ.ConfigStore.Folder)
            exists = ok and value == true
        end
        if not exists then pcall(Util.MakeFolder, xDTaraZ.ConfigStore.Folder) end
    end
    return true
end

function xDTaraZ.ConfigStore.Exists(path)
    if not (xDTaraZ.Caps.FileSystem and Util.ReadFile) then return false end
    if Util.IsFile then
        local ok, value = pcall(Util.IsFile, path)
        if ok then return value == true end
    end
    return pcall(Util.ReadFile, path)
end

local OptionSchema = {
    AimSmooth={"number",1,20}, AimPrediction={"number",0,500}, AimFov={"number",20,2000}, AimMaxDistance={"number",50,5000},
    HitChance={"number",0,100}, RageFov={"number",20,2000}, RageMaxDistance={"number",50,5000}, RageReactionDelay={"number",0,500}, TargetSwitchDelay={"number",0,5000},
    FlyKillSpeed={"number",20,200}, FlyKillDistance={"number",1,50}, FlyKillHeight={"number",0,30}, FlyKillSmooth={"number",0,99},
    ESPMaxDistance={"number",0,10000}, ESPBoxThickness={"number",1,4}, ESPDrawingOpacity={"number",5,100}, CrosshairSize={"number",1,64}, CrosshairGap={"number",0,64}, CrosshairThickness={"number",1,8},
    GuiScale={"number",60,110}, MinLockTime={"number",0,2000}, SpawnGrace={"number",0,3000},
    PredictionStrength={"number",0,200}, AutoSaveDelay={"number",0.25,10}, SpinSpeed={"number",90,2160},
}

local function NormalizeOption(key, value)
    local current = xDTaraZ.Options[key]
    if current == nil then return nil end
    local expected = type(current)
    -- Do not use `condition and value or current` for booleans here.
    -- A saved false is a valid setting, but Lua would treat it as the fallback
    -- branch and restore the current/default value instead.
    if expected == "boolean" then
        if type(value) == "boolean" then return value end
        return current
    end
    if expected == "string" then return type(value) == "string" and value or current end
    if expected == "number" then
        local number = tonumber(value)
        if not number then return current end
        local schema = OptionSchema[key]
        if schema then number = math.clamp(number, schema[2], schema[3]) end
        return number
    end
    if expected == "table" then return type(value) == "table" and value or current end
    return current
end

local function Serializable(value, depth)
    depth = depth or 0
    if depth > 5 then return nil end
    local kind = type(value)
    if kind == "boolean" or kind == "number" or kind == "string" then return value end
    if kind ~= "table" then return nil end
    local out = {}
    for k, v in pairs(value) do
        if type(k) == "string" or type(k) == "number" then
            local clean = Serializable(v, depth + 1)
            if clean ~= nil then out[k] = clean end
        end
    end
    return out
end

xDTaraZ.ConfigStore.DefaultOptions = Serializable(xDTaraZ.Options)

function xDTaraZ.ConfigStore.ReadJson(path)
    if not xDTaraZ.ConfigStore.Exists(path) then return false, "File not found" end
    local okRead, body = pcall(Util.ReadFile, path)
    if not okRead then return false, tostring(body) end
    local okJson, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not okJson or type(data) ~= "table" then return false, "Invalid config JSON" end
    return true, data
end

function xDTaraZ.ConfigStore.WriteJson(path, payload)
    local ok, body = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then return false, tostring(body) end
    local wrote, err = pcall(Util.WriteFile, path, body)
    if not wrote then return false, tostring(err) end
    -- read it back: some executors accept writefile but never create the file
    if Util.ReadFile then
        local readOk, back = pcall(Util.ReadFile, path)
        if not readOk or back ~= body then return false, "the file could not be read back after writing" end
    end
    return true, body
end

function xDTaraZ.ConfigStore.ReadMeta()
    local ok, data = xDTaraZ.ConfigStore.ReadJson(xDTaraZ.ConfigStore.MetaPath())
    return ok and data or nil
end

function xDTaraZ.ConfigStore.SaveMeta(profile)
    if not xDTaraZ.ConfigStore.EnsureFolder() then return false end
    local previous = xDTaraZ.ConfigStore.ReadMeta() or {}
    local lastProfile = previous.LastProfile
    -- The Settings toggles call SaveMeta() with no argument. That used to run SetSelectedProfile(nil),
    -- which silently switched you to Default and let the next auto-save overwrite it with your settings.
    if xDTaraZ.Options.RememberLastProfile then
        lastProfile = xDTaraZ.ConfigStore.Known(profile) or xDTaraZ.ConfigStore.ActiveProfile()
    end
    local index = xDTaraZ.ConfigStore.Index
    local names, deleted = {}, {}
    for _, name in ipairs(index.Names) do if not SameName(name, DEFAULT_PROFILE) then names[#names + 1] = name end end
    for key in pairs(index.Deleted) do deleted[#deleted + 1] = key end
    table.sort(deleted)
    local ok = xDTaraZ.ConfigStore.WriteJson(xDTaraZ.ConfigStore.MetaPath(), {
        LastProfile = lastProfile,
        Profiles = names,
        Deleted = deleted,
        AutoLoadConfig = xDTaraZ.Options.AutoLoadConfig == true,
        RememberLastProfile = xDTaraZ.Options.RememberLastProfile == true,
        AutoSaveOnJoin = xDTaraZ.Options.AutoSaveOnJoin == true,
        AutoSaveOnUnload = xDTaraZ.Options.AutoSaveOnUnload == true,
        SavedAt = os.time(),
        Version = xDTaraZ.Build.Version,
    })
    return ok
end

function xDTaraZ.ConfigStore.Snapshot(profile)
    local options = Serializable(xDTaraZ.Options)
    return { Profile=profile, SavedAt=os.time(), Version=xDTaraZ.Build.Version, Options=options }
end

function xDTaraZ.ConfigStore.Save(profile)
    profile = xDTaraZ.ConfigStore.SetSelectedProfile(profile or xDTaraZ.ConfigStore.ActiveProfile())
    if not xDTaraZ.ConfigStore.EnsureFolder() or not Util.WriteFile then
        xDTaraZ.ConfigStore.Last = "Filesystem unsupported"
        return false, xDTaraZ.ConfigStore.Last
    end
    local snapshot = xDTaraZ.ConfigStore.Snapshot(profile)
    local wrote, result = xDTaraZ.ConfigStore.WriteJson(xDTaraZ.ConfigStore.Path(profile), snapshot)
    if not wrote and Util.MakeFolder and not xDTaraZ.ConfigStore.UseFlat then
        xDTaraZ.ConfigStore.UseFlat = true
        local wroteFlat, resultFlat = xDTaraZ.ConfigStore.WriteJson(xDTaraZ.ConfigStore.Path(profile), snapshot)
        if wroteFlat then wrote, result = true, resultFlat else xDTaraZ.ConfigStore.UseFlat = false end
    end
    if wrote then
        xDTaraZ.ConfigStore.LastSavedAt = os.time()
        xDTaraZ.ConfigStore.SaveMeta(profile)
        xDTaraZ.ConfigStore.Last = "Saved " .. profile .. (xDTaraZ.ConfigStore.UseFlat and " (workspace root)" or "")
    else
        xDTaraZ.ConfigStore.Last = "Save failed: " .. tostring(result)
    end
    return wrote, xDTaraZ.ConfigStore.Last
end

function xDTaraZ.ConfigStore.ApplyData(data)
    if type(data.Options) ~= "table" then return end
    for key, value in pairs(data.Options) do
        if key ~= "ConfigProfile" and xDTaraZ.Options[key] ~= nil then
            local normalized = NormalizeOption(key, value)
            local control = xDTaraZ.UI and xDTaraZ.UI.Controls and xDTaraZ.UI.Controls[key]
            if control and control.Set then control.Set(normalized) else xDTaraZ.Options[key] = normalized end
        end
    end
end

function xDTaraZ.ConfigStore.Load(profile)
    local name = profile ~= nil and xDTaraZ.ConfigStore.Known(profile) or (profile == nil and xDTaraZ.ConfigStore.ActiveProfile() or nil)
    if not name then
        xDTaraZ.ConfigStore.Last = "No profile called " .. tostring(profile)
        return false, xDTaraZ.ConfigStore.Last
    end
    local ok, data = xDTaraZ.ConfigStore.ReadJson(xDTaraZ.ConfigStore.Path(name))
    if not ok and Util.MakeFolder and not xDTaraZ.ConfigStore.UseFlat then
        local flatOk, flatData = xDTaraZ.ConfigStore.ReadJson(xDTaraZ.ConfigStore.FlatPath(name))
        if flatOk then ok, data, xDTaraZ.ConfigStore.UseFlat = true, flatData, true end
    end
    if not ok then
        xDTaraZ.ConfigStore.Last = "No saved config yet. Press Save Config first"
        return false, xDTaraZ.ConfigStore.Last
    end
    -- Start from the defaults, then apply what this profile stored. Without the reset, any setting a
    -- profile does not mention kept the value of whichever profile you were using before.
    xDTaraZ.ConfigStore.ResetOptions()
    xDTaraZ.ConfigStore.ApplyData(data)
    xDTaraZ.Options.ConfigProfile = name
    xDTaraZ.ConfigStore.LastSavedAt = tonumber(data.SavedAt) or xDTaraZ.ConfigStore.LastSavedAt
    xDTaraZ.ConfigStore.SaveMeta(name)
    xDTaraZ.ConfigStore.Last = "Loaded " .. name
    return true, xDTaraZ.ConfigStore.Last
end

function xDTaraZ.ConfigStore.LoadLast()
    local meta = xDTaraZ.ConfigStore.ReadMeta()
    local profile = type(meta) == "table" and type(meta.LastProfile) == "string" and meta.LastProfile or nil
    if not profile then return false, "No remembered profile" end
    return xDTaraZ.ConfigStore.Load(profile)
end

function xDTaraZ.ConfigStore.ResetCurrent()
    local profile = xDTaraZ.ConfigStore.ActiveProfile()
    xDTaraZ.ConfigStore.ResetOptions()
    xDTaraZ.Options.ConfigProfile = profile
    return xDTaraZ.ConfigStore.Save(profile)
end

function xDTaraZ.ConfigStore.StartupLoad()
    if xDTaraZ.ConfigStore.StartupDone then return end
    xDTaraZ.ConfigStore.StartupDone = true
    local meta = xDTaraZ.ConfigStore.ReadMeta()
    xDTaraZ.ConfigStore.LoadIndex(meta)
    if type(meta) == "table" then
        for _, key in ipairs({ "AutoLoadConfig", "RememberLastProfile", "AutoSaveOnJoin", "AutoSaveOnUnload" }) do
            if type(meta[key]) == "boolean" then xDTaraZ.Options[key] = meta[key] end
        end
    end
    if not xDTaraZ.Options.AutoLoadConfig then xDTaraZ.ConfigStore.Last = "Startup autoload off" return end
    local profile = DEFAULT_PROFILE
    xDTaraZ.Options.ConfigProfile = DEFAULT_PROFILE
    local ok, msg = xDTaraZ.ConfigStore.Load(profile)
    if not ok then
        xDTaraZ.ConfigStore.Last = "Startup: " .. msg
        -- a config exists but could not be read: never let Save on Join replace it with defaults
        xDTaraZ.ConfigStore.StartupFailed = xDTaraZ.ConfigStore.Exists(xDTaraZ.ConfigStore.Path(profile))
    end
end

-- Writes, reads back and deletes a small probe file so you can see what your executor allows.
function xDTaraZ.ConfigStore.SelfTest()
    if not xDTaraZ.Caps.FileSystem then return "This executor has no writefile / readfile" end
    xDTaraZ.ConfigStore.EnsureFolder()
    local note = ""
    local probe = (Util.MakeFolder and not xDTaraZ.ConfigStore.UseFlat) and (xDTaraZ.ConfigStore.Folder .. "/test.tmp") or "KizzySniper_test.tmp"
    local ok, err = pcall(Util.WriteFile, probe, "ok")
    if not ok and probe ~= "KizzySniper_test.tmp" then
        probe = "KizzySniper_test.tmp"
        ok, err = pcall(Util.WriteFile, probe, "ok")
        if ok then xDTaraZ.ConfigStore.UseFlat = true; note = " (folders blocked, using workspace root)" end
    end
    if not ok then return "Cannot write files: " .. tostring(err) end
    local readOk, back = pcall(Util.ReadFile, probe)
    if Util.DeleteFile then pcall(Util.DeleteFile, probe) end
    if not readOk or back ~= "ok" then return "Wrote a file but could not read it back" end
    return "File saving works" .. note
end

function xDTaraZ.ConfigStore.GetSaveStatus()
    if not xDTaraZ.ConfigStore.LastSavedAt then return "Not saved this session" end
    local ok, text = pcall(os.date, "%H:%M:%S", xDTaraZ.ConfigStore.LastSavedAt)
    return ok and text or tostring(xDTaraZ.ConfigStore.LastSavedAt)
end

function xDTaraZ.ConfigStore.GetStatus()
    return xDTaraZ.ConfigStore.Last
end

-- ---------------------------------------------------------------- profile management
local KEEP_ON_RESET = { ConfigProfile = true, AutoLoadConfig = true, RememberLastProfile = true, AutoSaveOnJoin = true, AutoSaveOnUnload = true }

function xDTaraZ.ConfigStore.ResetOptions()
    for key, value in pairs(xDTaraZ.ConfigStore.DefaultOptions or {}) do
        if not KEEP_ON_RESET[key] then xDTaraZ.Options[key] = Serializable(value) end
    end
end

-- Reads the profile list remembered in the meta file. Older installs have none: keep any data saved
-- under the old preset names (PvP / Rage / Farm) but do not offer them as presets any more.
function xDTaraZ.ConfigStore.LoadIndex(meta)
    local names, deleted = { DEFAULT_PROFILE }, {}
    local function add(name)
        for _, existing in ipairs(names) do if SameName(existing, name) then return end end
        names[#names + 1] = name
    end
    if type(meta) == "table" and type(meta.Profiles) == "table" then
        for _, name in ipairs(meta.Profiles) do
            local clean = type(name) == "string" and xDTaraZ.ConfigStore.SanitizeProfile(name) or nil
            if clean then add(clean) end
        end
        if type(meta.Deleted) == "table" then
            for _, key in ipairs(meta.Deleted) do if type(key) == "string" then deleted[string.lower(key)] = true end end
        end
    else
        for _, legacy in ipairs(LEGACY_PROFILES) do
            if xDTaraZ.ConfigStore.Exists(xDTaraZ.ConfigStore.Path(legacy)) then add(legacy) end
        end
    end
    local index = xDTaraZ.ConfigStore.Index
    index.Names, index.Deleted = names, deleted
    xDTaraZ.ConfigStore.InvalidateFiles()
end

---@return boolean, string  save the CURRENT settings under a new name and switch to it
function xDTaraZ.ConfigStore.Create(name)
    local clean = xDTaraZ.ConfigStore.SanitizeProfile(name)
    if not clean then return false, "Type a profile name first" end
    if xDTaraZ.ConfigStore.Known(clean) then return false, "A profile called " .. clean .. " already exists" end
    if not xDTaraZ.Caps.FileSystem then return false, "This executor cannot save files" end
    local index = xDTaraZ.ConfigStore.Index
    index.Deleted[string.lower(clean)] = nil
    index.Names[#index.Names + 1] = clean
    xDTaraZ.ConfigStore.InvalidateFiles()
    local ok, msg = xDTaraZ.ConfigStore.Save(clean)
    if not ok then
        table.remove(index.Names)
        return false, msg
    end
    xDTaraZ.ConfigStore.Last = "Created " .. clean
    return true, "Created " .. clean
end

---@return boolean, string  switch to a profile (never loses unsaved changes of the one you leave)
function xDTaraZ.ConfigStore.Select(name)
    local known = xDTaraZ.ConfigStore.Known(name)
    if not known then return false, "No profile called " .. tostring(name) end
    local current = xDTaraZ.ConfigStore.ActiveProfile()
    if SameName(known, current) then return true, known .. " is already active" end
    if xDTaraZ.Options.AutoSave and xDTaraZ.AutoSave and xDTaraZ.AutoSave.Dirty then
        xDTaraZ.AutoSave.Dirty = false
        xDTaraZ.ConfigStore.Save(current)
    end
    return xDTaraZ.ConfigStore.Load(known)
end

function xDTaraZ.ConfigStore.Delete(name)
    local known = xDTaraZ.ConfigStore.Known(name)
    if not known then return false, "No profile called " .. tostring(name) end
    if SameName(known, DEFAULT_PROFILE) then return false, "Default cannot be deleted (use Reset instead)" end
    local wasActive = SameName(known, xDTaraZ.ConfigStore.ActiveProfile())
    local path = xDTaraZ.ConfigStore.Path(known)
    if Util.DeleteFile then pcall(Util.DeleteFile, path) end
    local index = xDTaraZ.ConfigStore.Index
    -- If the executor cannot delete files (or the delete failed), at least hide it for good.
    if xDTaraZ.ConfigStore.Exists(path) then index.Deleted[string.lower(known)] = true end
    for i = #index.Names, 1, -1 do
        if SameName(index.Names[i], known) then table.remove(index.Names, i) end
    end
    xDTaraZ.ConfigStore.InvalidateFiles()
    if wasActive then
        -- switch away first, so nothing can auto-save into the name we just deleted
        xDTaraZ.Options.ConfigProfile = DEFAULT_PROFILE
        xDTaraZ.ConfigStore.Load(DEFAULT_PROFILE)
    end
    xDTaraZ.ConfigStore.SaveMeta(xDTaraZ.ConfigStore.ActiveProfile())
    xDTaraZ.ConfigStore.Last = "Deleted " .. known
    return true, "Deleted " .. known
end

function xDTaraZ.ConfigStore.Rename(oldName, newName)
    local old = xDTaraZ.ConfigStore.Known(oldName)
    if not old then return false, "No profile called " .. tostring(oldName) end
    if SameName(old, DEFAULT_PROFILE) then return false, "Default cannot be renamed" end
    local clean = xDTaraZ.ConfigStore.SanitizeProfile(newName)
    if not clean then return false, "Type the new name first" end
    if not SameName(clean, old) and xDTaraZ.ConfigStore.Known(clean) then return false, "A profile called " .. clean .. " already exists" end
    if not Util.DeleteFile then return false, "This executor cannot delete files, so it cannot rename" end
    local oldPath, newPath = xDTaraZ.ConfigStore.Path(old), xDTaraZ.ConfigStore.Path(clean)
    local okRead, body = pcall(Util.ReadFile, oldPath)
    if not okRead then return false, "Could not read " .. old end
    local okWrite = pcall(Util.WriteFile, newPath, body)
    if not okWrite then return false, "Could not write " .. clean end
    if oldPath ~= newPath then pcall(Util.DeleteFile, oldPath) end
    local index = xDTaraZ.ConfigStore.Index
    for i, existing in ipairs(index.Names) do
        if SameName(existing, old) then index.Names[i] = clean end
    end
    index.Deleted[string.lower(clean)] = nil
    if SameName(old, xDTaraZ.ConfigStore.ActiveProfile()) or SameName(old, xDTaraZ.Options.ConfigProfile) then xDTaraZ.Options.ConfigProfile = clean end
    xDTaraZ.ConfigStore.InvalidateFiles()
    xDTaraZ.ConfigStore.SaveMeta(xDTaraZ.ConfigStore.ActiveProfile())
    xDTaraZ.ConfigStore.Last = "Renamed to " .. clean
    return true, "Renamed " .. old .. " to " .. clean
end

-- Crosshair overlay.
xDTaraZ.Crosshair = { Objects = {} }

function xDTaraZ.Crosshair.Color()
    local name = xDTaraZ.Options.CrosshairColor
    if name == "White" then return Color3.new(1,1,1) end
    if name == "Red" then return Color3.fromRGB(255,80,90) end
    if name == "Green" then return Color3.fromRGB(80,255,150) end
    if name == "Blue" then return Color3.fromRGB(80,190,255) end
    return Color3.fromRGB(126,92,255)
end

function xDTaraZ.Crosshair.Clear()
    for _, object in pairs(xDTaraZ.Crosshair.Objects) do pcall(function() object:Remove() end) end
    table.clear(xDTaraZ.Crosshair.Objects)
end

function xDTaraZ.Crosshair.Step()
    if not xDTaraZ.Caps.Drawing then return end
    if not xDTaraZ.Options.ShowCrosshair then
        for _, object in pairs(xDTaraZ.Crosshair.Objects) do object.Visible = false end
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local center = cam.ViewportSize / 2
    local style = xDTaraZ.Options.CrosshairStyle or "Plus"
    local color = xDTaraZ.Crosshair.Color()
    local thickness = math.max(1, tonumber(xDTaraZ.Options.CrosshairThickness) or 1)

    if style == "Dot" then
        if not xDTaraZ.Crosshair.Objects.Dot then
            local dot = Drawing.new("Circle"); dot.Filled = true; dot.NumSides = 24
            xDTaraZ.Crosshair.Objects.Dot = dot
        end
        local dot = xDTaraZ.Crosshair.Objects.Dot
        dot.Position = center; dot.Radius = math.max(2, tonumber(xDTaraZ.Options.CrosshairSize) or 6) / 2
        dot.Color = color; dot.Visible = true
        for name, object in pairs(xDTaraZ.Crosshair.Objects) do if name ~= "Dot" then object.Visible = false end end
        return
    end

    if xDTaraZ.Crosshair.Objects.Dot then xDTaraZ.Crosshair.Objects.Dot.Visible = false end
    local size = math.max(2, tonumber(xDTaraZ.Options.CrosshairSize) or 8)
    local gap = math.max(0, tonumber(xDTaraZ.Options.CrosshairGap) or 4)
    local defs = {
        Left = { center - Vector2.new(gap + size, 0), center - Vector2.new(gap, 0) },
        Right = { center + Vector2.new(gap, 0), center + Vector2.new(gap + size, 0) },
        Top = { center - Vector2.new(0, gap + size), center - Vector2.new(0, gap) },
        Bottom = { center + Vector2.new(0, gap), center + Vector2.new(0, gap + size) },
    }
    for name, points in pairs(defs) do
        local line = xDTaraZ.Crosshair.Objects[name]
        if not line then line = Drawing.new("Line"); xDTaraZ.Crosshair.Objects[name] = line end
        line.From, line.To = points[1], points[2]
        line.Color, line.Thickness, line.Visible = color, thickness, true
    end
end

-- Lightweight performance scheduler. Keeps visual jobs slower in Performance Mode
-- without running a separate FPS/ping/session counter every frame.
xDTaraZ.Session = {}

function xDTaraZ.Session.Step()
    local jobs = xDTaraZ.Scheduler.Jobs
    if xDTaraZ.Options.PerformanceMode then
        if jobs.ESP then jobs.ESP.Interval = 0.16 end
        if jobs.TargetIndicator then jobs.TargetIndicator.Interval = 0.08 end
        if jobs.Crosshair then jobs.Crosshair.Interval = 0.05 end
    else
        if jobs.ESP then jobs.ESP.Interval = 0.08 end
        if jobs.TargetIndicator then jobs.TargetIndicator.Interval = 0.04 end
        if jobs.Crosshair then jobs.Crosshair.Interval = 0.03 end
    end
end

