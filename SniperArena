function xDTaraZ.Esp.IsEnabled()
    return xDTaraZ.Options.ESP == true
end

function xDTaraZ.Esp.Step()
    -- One master ESP switch. Individual visuals and the working ESP Options
    -- below only affect rendering while this master switch is enabled.
    if not xDTaraZ.Options.ESP then
        if next(xDTaraZ.Esp.Tags) or next(xDTaraZ.Esp.Highlights) or next(xDTaraZ.Esp.Tracers) or next(xDTaraZ.Esp.Boxes) or next(xDTaraZ.Esp.Skeletons) or next(xDTaraZ.Esp.Arrows) or next(xDTaraZ.Esp.VerticalHealth) then
            xDTaraZ.Esp.Clear()
        end
        return
    end

    local cam = Workspace.CurrentCamera
    local myRoot = xDTaraZ.Player.Root
    local active = {}
    local count = 0

    for _, entity in pairs(xDTaraZ.Entity.ESPList()) do
        if type(entity) ~= "table" and typeof(entity) ~= "table" then continue end
        if xDTaraZ.Entity.IsLocal(entity) then continue end
        local friendly = xDTaraZ.Entity.Friendly(entity)
        if friendly and not xDTaraZ.Options.ESPTeammates then continue end
        local character = xDTaraZ.Entity.Character(entity)
        local health, maxHealth = xDTaraZ.Entity.Health(entity)
        local root = xDTaraZ.Entity.Root(entity)
        if not character or not character.Parent or not root or health <= 0 then continue end
        local distance = myRoot and (root.Position - myRoot.Position).Magnitude or 0
        local maxEspDistance = Util.Number(xDTaraZ.Options.ESPMaxDistance, 2000, 0, 10000)
        if maxEspDistance > 0 and distance > maxEspDistance then continue end

        local isVisible = xDTaraZ.Esp.CachedLineOfSight(root, character)

        active[character] = true
        count += 1

        local showInfo = xDTaraZ.Options.ESPNames or xDTaraZ.Options.ESPDistance or xDTaraZ.Options.ESPHealth
        if showInfo then
            local tag = xDTaraZ.Esp.Tag(character, root)
            tag.Label.TextSize = Util.Number(xDTaraZ.Options.ESPTextSize,12,8,22)
            local parts = {}
            if xDTaraZ.Options.ESPNames then parts[#parts + 1] = character.Name end
            if xDTaraZ.Options.ESPDistance then
                parts[#parts + 1] = string.format("%dm", math.floor(distance + 0.5))
            end
            if xDTaraZ.Options.ESPHealth then
                local hp = maxHealth > 0 and math.floor(health / maxHealth * 100 + 0.5) or math.floor(health)
                parts[#parts + 1] = hp .. "%"
                tag.Back.Visible = true
                tag.Fill.Size = UDim2.fromScale(math.clamp(maxHealth > 0 and health / maxHealth or 0, 0, 1), 1)
            else
                tag.Back.Visible = false
            end
            tag.Label.Text = table.concat(parts, " · ")
            -- BillboardGui uses fixed pixels by default. Shrink the information/health
            -- tag with distance so it does not dwarf far-away players.
            local tagScale = math.clamp(1 - (distance / 2200), 0.42, 1)
            local tagWidth = math.floor(180 * tagScale + 0.5)
            local tagHeight = math.floor(44 * tagScale + 0.5)
            tag.Gui.Size = UDim2.fromOffset(tagWidth, tagHeight)
            tag.Gui.StudsOffset = Vector3.new(0, 2.7 + 0.6 * tagScale, 0)
            tag.Label.Size = UDim2.new(1, 0, 0, math.max(14, math.floor(26 * tagScale)))
            tag.Label.TextSize = math.max(8, math.floor(Util.Number(xDTaraZ.Options.ESPTextSize,12,8,22) * tagScale + 0.5))
            tag.Back.Position = UDim2.fromOffset(math.floor(20 * tagScale), math.floor(29 * tagScale))
            tag.Back.Size = UDim2.new(1, -math.floor(40 * tagScale), 0, math.max(2, math.floor(6 * tagScale)))
        else
            local tag = xDTaraZ.Esp.Tags[character]
            if tag and tag.Gui then tag.Gui.Enabled = false end
        end

        local drawColor = xDTaraZ.Esp.DrawColor(friendly, isVisible)
        local drawOpacity = math.clamp(Util.Number(xDTaraZ.Options.ESPDrawingOpacity,90,5,100) / 100, 0.05, 1)

        -- The master ESP always gives a visible through-wall highlight.
        -- This works even when the executor has no Drawing API.
        local highlight = xDTaraZ.Esp.Highlight(character)
        highlight.FillColor = drawColor
        highlight.OutlineColor = drawColor
        highlight.Enabled = true
        local minX, minY, maxX, maxY
        local rootScreen, rootOnScreen
        if cam then
            rootScreen, rootOnScreen = cam:WorldToViewportPoint(root.Position)
            rootOnScreen = rootOnScreen and rootScreen.Z > 0
        end
        -- GetBoundingBox + eight WorldToViewportPoint calls are relatively expensive.
        -- Only calculate full bounds for targets whose root is actually on-screen.
        if rootOnScreen and (xDTaraZ.Options.ESPBoxes or xDTaraZ.Options.ESPSkeleton or xDTaraZ.Options.ESPVerticalHealth or xDTaraZ.Options.ESPTracers) then
            minX, minY, maxX, maxY = xDTaraZ.Esp.ScreenBounds(character, cam)
            if minX then
                local cx, cy = (minX + maxX) * 0.5, (minY + maxY) * 0.5
                local width = (maxX - minX) * Util.Number(xDTaraZ.Options.ESPBoxWidth,100,50,175) / 100
                local height = (maxY - minY) * Util.Number(xDTaraZ.Options.ESPBoxHeight,100,50,175) / 100
                cy += Util.Number(xDTaraZ.Options.ESPBoxYOffset,0,-100,100)
                minX, maxX = cx - width * 0.5, cx + width * 0.5
                minY, maxY = cy - height * 0.5, cy + height * 0.5
            end
        end

        if xDTaraZ.Options.ESPTracers and cam then
            local line=xDTaraZ.Esp.Tracer(character)
            local originMode=xDTaraZ.Options.ESPTracerOrigin or "Bottom"
            local from
            if originMode=="Mouse" then local m=UserInputService:GetMouseLocation(); from=Vector2.new(m.X,m.Y)
            elseif originMode=="Center" then from=cam.ViewportSize/2
            else from=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y-8) end
            local screen,onScreen=rootScreen,rootOnScreen
            if onScreen and screen then
                local targetMode=xDTaraZ.Options.ESPTracerTarget or "Feet"
                local to
                if targetMode=="Center" and minX then to=Vector2.new((minX+maxX)*.5,(minY+maxY)*.5)
                elseif targetMode=="Feet" and minX then to=Vector2.new((minX+maxX)*.5,maxY)
                else to=Vector2.new(screen.X,screen.Y) end
                setGuiLine(line,from,to,drawColor,Util.Number(xDTaraZ.Options.ESPTracerThickness,1,1,4),drawOpacity)
            else line.Visible=false end
        else xDTaraZ.Esp.DestroyTracer(character) end

        if xDTaraZ.Options.ESPBoxes and minX then
            local box=xDTaraZ.Esp.Box(character)
            local thickness=Util.Number(xDTaraZ.Options.ESPBoxThickness,1,1,4)
            for n,l in pairs(box) do if n~="Container" then l.Visible=false end end
            if (xDTaraZ.Options.ESPBoxStyle or "Full")=="Corner" then
                local w,h=maxX-minX,maxY-minY
                local c=math.max(2,math.min(w,h)*Util.Number(xDTaraZ.Options.ESPCornerLength,28,10,50)/100)
                local seg={TLH={Vector2.new(minX,minY),Vector2.new(minX+c,minY)},TLV={Vector2.new(minX,minY),Vector2.new(minX,minY+c)},TRH={Vector2.new(maxX,minY),Vector2.new(maxX-c,minY)},TRV={Vector2.new(maxX,minY),Vector2.new(maxX,minY+c)},BLH={Vector2.new(minX,maxY),Vector2.new(minX+c,maxY)},BLV={Vector2.new(minX,maxY),Vector2.new(minX,maxY-c)},BRH={Vector2.new(maxX,maxY),Vector2.new(maxX-c,maxY)},BRV={Vector2.new(maxX,maxY),Vector2.new(maxX,maxY-c)}}
                for n,v in pairs(seg) do setGuiLine(box[n],v[1],v[2],drawColor,thickness,drawOpacity) end
            else
                setGuiLine(box.Top,Vector2.new(minX,minY),Vector2.new(maxX,minY),drawColor,thickness,drawOpacity)
                setGuiLine(box.Bottom,Vector2.new(minX,maxY),Vector2.new(maxX,maxY),drawColor,thickness,drawOpacity)
                setGuiLine(box.Left,Vector2.new(minX,minY),Vector2.new(minX,maxY),drawColor,thickness,drawOpacity)
                setGuiLine(box.Right,Vector2.new(maxX,minY),Vector2.new(maxX,maxY),drawColor,thickness,drawOpacity)
            end
        elseif xDTaraZ.Options.ESPBoxes then
            local e=xDTaraZ.Esp.Boxes[character]; if e then for n,l in pairs(e) do if n~="Container" then l.Visible=false end end end
        else xDTaraZ.Esp.DestroyBox(character) end

        if xDTaraZ.Options.ESPSkeleton and minX then
            local now = osClock()
            if now >= (xDTaraZ.Esp.SkeletonNext[character] or 0) then
                xDTaraZ.Esp.SkeletonNext[character] = now + 0.20
                xDTaraZ.Esp.DrawSkeleton(character, minX, minY, maxX, maxY, drawColor, drawOpacity)
            end
        elseif xDTaraZ.Options.ESPSkeleton then
            local existing = xDTaraZ.Esp.Skeletons[character]
            if existing then
                for _, line in ipairs(existing.Lines or {}) do line.Visible = false end
            end
        else
            xDTaraZ.Esp.DestroySkeleton(character)
        end

        if xDTaraZ.Options.ESPVerticalHealth and minX then
            local bars=xDTaraZ.Esp.HealthLines(character)
            local ratio=math.clamp(maxHealth>0 and health/maxHealth or 0,0,1)
            local x=minX-6
            local thick=Util.Number(xDTaraZ.Options.ESPHealthThickness,2,1,6)
            setGuiLine(bars.Back,Vector2.new(x,maxY),Vector2.new(x,minY),Color3.fromRGB(45,20,20),thick+2,drawOpacity)
            setGuiLine(bars.Fill,Vector2.new(x,maxY),Vector2.new(x,maxY-(maxY-minY)*ratio),Color3.fromRGB(255,60,60):Lerp(Color3.fromRGB(70,235,120),ratio),thick,drawOpacity)
        elseif xDTaraZ.Options.ESPVerticalHealth then
            local e=xDTaraZ.Esp.VerticalHealth[character]; if e then e.Back.Visible=false; e.Fill.Visible=false end
        else xDTaraZ.Esp.DestroyVerticalHealth(character) end

        -- Off-screen arrows: an edge marker pointing at enemies you cannot currently see.
        if xDTaraZ.Options.ESPOffscreen and xDTaraZ.Caps.Drawing and cam then
            local screen, onScreen = cam:WorldToViewportPoint(root.Position)
            if onScreen and screen.Z > 0 then
                xDTaraZ.Esp.DestroyArrow(character)
            else
                local relative = cam.CFrame:PointToObjectSpace(root.Position)
                local dx, dy = relative.X, -relative.Y
                local length = math.sqrt(dx * dx + dy * dy)
                if length < 0.001 then dx, dy, length = 0, 1, 1 end     -- directly behind or in front
                dx, dy = dx / length, dy / length
                local center = cam.ViewportSize / 2
                local maxRadius = math.max(40, math.min(cam.ViewportSize.X, cam.ViewportSize.Y) / 2 - 30)
                local radius = math.clamp(Util.Number(xDTaraZ.Options.ESPArrowRadius,230,30,600), 30, maxRadius)
                local size = Util.Number(xDTaraZ.Options.ESPArrowSize,18,6,40)
                local tip = center + Vector2.new(dx * radius, dy * radius)
                local base = tip - Vector2.new(dx * size, dy * size)
                local side = Vector2.new(-dy, dx) * (size * 0.5)
                local arrow = xDTaraZ.Esp.Arrows[character]
                if not arrow then
                    arrow = Drawing.new("Triangle")
                    arrow.Filled = true
                    arrow.Transparency = drawOpacity
                    xDTaraZ.Esp.Arrows[character] = arrow
                end
                arrow.PointA, arrow.PointB, arrow.PointC = tip, base + side, base - side
                arrow.Color = drawColor
                arrow.Transparency = drawOpacity
                arrow.Visible = true
            end
        else
            xDTaraZ.Esp.DestroyArrow(character)
        end
    end

    for character in pairs(xDTaraZ.Esp.Highlights) do
        if not active[character] then xDTaraZ.Esp.DestroyHighlight(character) end
    end
    for character, tag in pairs(xDTaraZ.Esp.Tags) do
        if not active[character] then
            if tag and tag.Gui then pcall(function() tag.Gui:Destroy() end) end
            xDTaraZ.Esp.Tags[character] = nil
        elseif tag and tag.Gui then
            tag.Gui.Enabled = xDTaraZ.Options.ESPNames or xDTaraZ.Options.ESPDistance or xDTaraZ.Options.ESPHealth
        end
    end
    for character in pairs(xDTaraZ.Esp.Tracers) do
        if not active[character] then xDTaraZ.Esp.DestroyTracer(character) end
    end
    for character in pairs(xDTaraZ.Esp.Boxes) do
        if not active[character] then xDTaraZ.Esp.DestroyBox(character) end
    end
    for character in pairs(xDTaraZ.Esp.Skeletons) do
        if not active[character] then xDTaraZ.Esp.DestroySkeleton(character) end
    end
    for character in pairs(xDTaraZ.Esp.Arrows) do
        if not active[character] then xDTaraZ.Esp.DestroyArrow(character) end
    end
    for character in pairs(xDTaraZ.Esp.VerticalHealth) do
        if not active[character] then xDTaraZ.Esp.DestroyVerticalHealth(character) end
    end
    for character in pairs(xDTaraZ.Esp.VisibilityCache) do
        if not active[character] then xDTaraZ.Esp.VisibilityCache[character] = nil end
    end
    for character in pairs(xDTaraZ.Esp.SkeletonNext) do
        if not active[character] then xDTaraZ.Esp.SkeletonNext[character] = nil end
    end
    xDTaraZ.Esp.Count = count
end

